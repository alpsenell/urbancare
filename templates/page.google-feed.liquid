{% layout none %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
  <channel>
    <title>{{ shop.name }}</title>
    <link>{{ shop.url }}</link>
    <description>{{ shop.description }}</description>
    {% paginate collections.all.products by 250 %}
      {% for product in collections.all.products %}
        {% for variant in product.variants %}
          {% if variant.available %}
            <item>
              <g:id>{{ variant.id }}</g:id>
              <g:title>{{ product.title | xml_escape }}{% unless variant.title == 'Default Title' %} - {{ variant.title | xml_escape }}{% endunless %}</g:title>
              <g:description>{{ product.description | strip_html | truncate: 5000 | xml_escape }}</g:description>
              <g:link>{{ shop.url }}/products/{{ product.handle }}{% if product.variants.size > 1 %}?variant={{ variant.id }}{% endif %}</g:link>
              <g:image_link>https:{{ product.featured_image | img_url: 'master' }}</g:image_link>
              {% for image in product.images offset: 1 limit: 9 %}
                <g:additional_image_link>https:{{ image | img_url: 'master' }}</g:additional_image_link>
              {% endfor %}
              <g:condition>new</g:condition>
              <g:availability>in_stock</g:availability>
              {% comment %} --- Fiyat: cent bazli tam sayi matematigi, binlik ayiraci yok, her zaman 2 ondalik --- {% endcomment %}
              {% assign reg_cents = variant.price %}
              {% if variant.compare_at_price > variant.price %}{% assign reg_cents = variant.compare_at_price %}{% endif %}
              {% assign reg_whole = reg_cents | divided_by: 100 %}
              {% assign reg_rem = reg_cents | modulo: 100 | prepend: '00' | slice: -2, 2 %}
              <g:price>{{ reg_whole }}.{{ reg_rem }} TRY</g:price>
              {% if variant.compare_at_price > variant.price %}
                {% assign sale_whole = variant.price | divided_by: 100 %}
                {% assign sale_rem = variant.price | modulo: 100 | prepend: '00' | slice: -2, 2 %}
                <g:sale_price>{{ sale_whole }}.{{ sale_rem }} TRY</g:sale_price>
              {% endif %}
              <g:brand>Urban Care</g:brand>
              {% if variant.sku != blank %}
                <g:mpn>{{ variant.sku | xml_escape }}</g:mpn>
                <g:identifier_exists>yes</g:identifier_exists>
              {% else %}
                <g:identifier_exists>no</g:identifier_exists>
              {% endif %}
              <g:item_group_id>{{ product.id }}</g:item_group_id>
              {% for tag in product.tags %}
                {% if tag contains 'gpc:' %}<g:google_product_category>{{ tag | remove: 'gpc:' }}</g:google_product_category>{% endif %}
                {% if tag contains 'color:' %}<g:color>{{ tag | remove: 'color:' | xml_escape }}</g:color>{% endif %}
                {% if tag contains 'size:' %}<g:size>{{ tag | remove: 'size:' | xml_escape }}</g:size>{% endif %}
              {% endfor %}
              <g:shipping>
                <g:country>TR</g:country>
                <g:service>Standart Kargo</g:service>
                <g:price>0 TRY</g:price>
              </g:shipping>
            </item>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endpaginate %}
  </channel>
</rss>
