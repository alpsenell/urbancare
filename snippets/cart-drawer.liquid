{%- comment %}
  ══════════════════════════════════════════════════════════════
  snippets/cart-drawer.liquid
  Free Gift motoru: eşik = otomatik indirimler sonrası ödenecek tutar
  (hediye satırları hariç). Eşik aşılınca hediye otomatik eklenir,
  altına düşünce otomatik silinir. Hediye satırı kilitlidir.
  ══════════════════════════════════════════════════════════════
{% endcomment -%}

{%- liquid
  assign show_gift_wrapping = false
  if settings.show_gift_wrapping and settings.gift_wrap_product != blank
    assign show_gift_wrapping = true
    assign gift_wrap_product_id = settings.gift_wrap_product.selected_or_first_available_variant.id
    assign gift_wraps_in_cart = 0

    for item in cart.items
      if item.id == gift_wrap_product_id and item.properties['_gift-wrap']
        assign gift_wraps_in_cart = item.quantity
        break
      endif
    endfor
  endif
%}

{%- comment %} ── FREE GIFT: section'dan gelen parametreleri normalize et ── {%- endcomment %}
{%- liquid
  assign gift_tiers_json = gift_tiers_json | default: '[]'
  assign gift_mode = gift_mode | default: 'highest'
  assign gift_badge_text = gift_badge_text | default: '🎁 Hediye'

  assign gift_lock = true
  if gift_lock_lines == false
    assign gift_lock = false
  endif

  assign gift_qty_up = false
  if gift_allow_qty_up == true
    assign gift_qty_up = true
  endif

  assign gift_section_id = section.id | default: 'cart-drawer'
-%}

<link rel="stylesheet" href="{{ 'cart.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'cart-summary-disclosure.js' | asset_url }}" defer></script>

{%- if show_gift_wrapping -%}
  <script src="{{ 'gift-wrap.js' | asset_url }}" defer></script>
  <script src="{{ 'cart-gift-message.js' | asset_url }}" defer></script>
{%- endif -%}

{%- if section.settings.show_order_note -%}
  <script src="{{ 'cart-note.js' | asset_url }}" defer></script>
{%- endif -%}

{%- comment %} ── FREE GIFT: hediye satırı kilit stilleri ── {%- endcomment %}
<style>
  [data-free-gift='true'] quantity-input,
  [data-free-gift='true'] .quantity-input,
  [data-free-gift='true'] .cart-item__quantity,
  [data-free-gift='true'] .cart-item__qty,
  [data-free-gift='true'] .cart-item__remove,
  [data-free-gift='true'] .js-remove-item,
  [data-free-gift='true'] [data-cart-remove],
  [data-free-gift='true'] a[href*='/cart/change'],
  [data-free-gift='true'] input[name^='updates'] {
    display: none !important;
  }

  [data-free-gift='true'] .cart-item__price s,
  [data-free-gift='true'] .cart-item__price del {
    display: none !important;
  }

  .free-gift-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-top: 0.35em;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.02em;
    background: rgba(0, 0, 0, 0.06);
    white-space: nowrap;
  }

  .free-gift-qty {
    display: block;
    font-size: 12px;
    opacity: 0.6;
  }

  [data-free-gift='true'] {
    position: relative;
  }
</style>

<cart-drawer
  class="drawer fixed top-0 right-0 flex flex-col w-full has-motion"
  id="cart-drawer"
  role="dialog"
  aria-label="{{ 'cart.general.title' | t }}"
  aria-modal="true"
  aria-hidden="true"
  tabindex="-1"
  data-section="{{ gift_section_id }}"
  data-name="cart-drawer"
  data-gift-tiers="{{ gift_tiers_json | escape }}"
  data-gift-mode="{{ gift_mode }}"
  data-gift-badge="{{ gift_badge_text | escape }}"
  data-gift-lock="{% if gift_lock %}true{% else %}false{% endif %}"
  data-gift-qty-up="{% if gift_qty_up %}true{% else %}false{% endif %}"
>
  <header class="drawer__header">
    <div class="flex flex-col gap-y-4">
      <div class="flex justify-between items-center gap-x-5">
        <div class="flex gap-x-3 flex-grow justify-between items-center js-drawer-header-title">
          <h2 class="drawer__heading mb-0 font-heading leading-normal">{{ 'cart.drawer.title' | t }}</h2>
          <div class="small-text">
            {{ 'cart.summary.item_count' | t: count: cart.item_count }}
          </div>
        </div>

        <button type="button" class="drawer__close-btn js-close-drawer" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon-close' %}
        </button>
      </div>
    </div>
  </header>

  {%- if section.settings.stick_footer == false -%}
  <div class="drawer__scroller flex-auto flex flex-col">
  {%- endif -%}

  <div class="drawer__content{% if cart == empty %} flex{% endif %} flex-auto justify-center items-center custom-case">
    {%- if settings.show_free_shipping_notice -%}
      {% render 'free-shipping-notice', bar_position: 'top', align_start: true %}
    {%- endif -%}

    <form class="form" id="cart-drawer-form" action="{{ routes.cart_url }}" method="post">
      {% render 'cart-items', is_drawer: true, show_gift_wrapping: show_gift_wrapping %}
      {% if settings.cart_message != blank and cart != empty %}
        <div class="drawer__custom-message text-sm rte p-2 text-center">
          {{ settings.cart_message }}
        </div>
      {% endif %}
    </form>

    {%- if settings.show_recommendations and cart != empty -%}
      {%- render 'recommendations',
        is_cart: true,
        heading: 'Sepeti Tamamla',
        layout: 'carousel',
        related_cards: true,
        grid_classes: 'grid grid-flow-col auto-cols-[84%] gap-x-4'
      -%}
    {%- endif -%}

    {%- if section.settings.suggested_products != blank -%}
      {%- render 'product-list',
        products: section.settings.suggested_products,
        products_to_show: 12,
        heading: section.settings.suggested_products_heading,
        layout: 'carousel',
        grid_classes: 'grid grid-flow-col auto-cols-[84%] gap-x-4'
      -%}
    {%- endif -%}
  </div>

  {% if cart != empty and show_gift_wrapping %}
    <cart-gift-wrap class="cart-gift-wrap block relative clearfix rte text-sm"
         data-gw-product-id="{{ gift_wrap_product_id }}"
         data-gw-cart-item-size="{{ cart.items.size }}"
         data-gw-cart-item-size-minus-gw="{{ cart.item_count | minus: gift_wraps_in_cart }}"
         data-gw-in-cart="{{ gift_wraps_in_cart }}"
         data-gw-attribute-blank="{% if cart.attributes.gift-wrap == blank %}true{% else %}false{% endif %}">
      <p class="cart-gift-wrap__inner text-sm mb-0">
        <input
          id="gift-wrap"
          class="checkbox checkbox--small"
          type="checkbox"
          name="attributes[gift-wrap]"
          value="yes"
          {% if cart.attributes.gift-wrap %}
            checked="checked"
          {% endif %}
        />
        <label for="gift-wrap" class="label">
          {%- assign gift_wrap_cost = settings.gift_wrap_product.price | money -%}
          <span>
            {{ 'cart.gift_message.checkbox_label_html' | t: money: gift_wrap_cost }}
          </span>
        </label>
      </p>
      <div class="cart-item__loader absolute top-0 left-0 flex justify-center items-center w-full h-full pointer-events-none is-loading" hidden></div>
    </cart-gift-wrap>
  {% endif %}

  <footer class="drawer__footer relative custom-case">
    {%- if cart != empty -%}
      {%- if section.settings.show_order_note or show_gift_wrapping -%}
        {% render 'cart-actions', show_gift_wrapping: show_gift_wrapping, in_drawer: true %}
        <hr class="drawer__footer-hr">
      {%- endif -%}

      <div class="text-xl flex flex-wrap justify-between items-baseline cart-subtotal font-bold{% if section.settings.show_tax_and_shipping == blank and cart.cart_level_discount_applications == blank %} mb-5{% endif %}">
        <span>{{ 'cart.summary.subtotal' | t }}</span>
        <span class="cart-subtotal__value">
          {%- if settings.show_cart_currency_code -%}
            {{- cart.total_price | money_with_currency -}}
          {%- else -%}
            {{- cart.total_price | money -}}
          {%- endif -%}
        </span>
      </div>

      {%- if cart.cart_level_discount_applications != blank -%}
        <ul class="mt-3" role="list" aria-label="{{ 'customer.order.discount' | t }}">
          {%- for discount in cart.cart_level_discount_applications -%}
            <li class="mt-2 first:mt-0">
              <div class="discount inline-flex items-start text-xs">
                {% render 'icon-tags' %}
                <span>{{ discount.title | escape_once }} (-{{ discount.total_allocated_amount | money }})</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_tax_and_shipping != blank -%}
        <p class="mb-5 rte">
          <small class="text-sm">
            <span>
              {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                {{ 'cart.general.taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- elsif cart.taxes_included -%}
                {{ 'cart.general.taxes_included_shipping_at_checkout' | t }}
              {%- elsif shop.shipping_policy.body != blank -%}
                {{ 'cart.general.taxes_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
              {%- endif -%}
            </span>
          </small>
        </p>
      {%- endif -%}

      {%- if section.settings.cart_terms_page != blank -%}
        <cart-terms class="block mb-4 text-sm">
          <input type="checkbox" class="checkbox checkbox--small" id="cart-terms">
          <label for="cart-terms" class="label">
            <span class="rte">{{ 'cart.terms.agreement_html' | t: terms_url: section.settings.cart_terms_page }}</span>
          </label>
        </cart-terms>
      {%- endif -%}

      <div class="grid grid-cols-1{% if section.settings.show_checkout_button %} sm:grid-cols-2 gap-x-4 gap-y-2{% endif %}">
        <a class="btn btn--secondary" href="{{ routes.cart_url }}">
          {{- 'cart.general.view_cart' | t -}}
        </a>

        {% if section.settings.show_checkout_button -%}
          <button type="submit" class="btn btn--primary w-full" name="checkout" form="cart-drawer-form"{% if cart == empty %} disabled{% endif %}>
            {{- 'cart.summary.checkout' | t -}}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </footer>

  {%- if section.settings.stick_footer == false -%}
  </div>
  {%- endif -%}

  <div class="overlay overlay--cart-actions overlay--drawer absolute top-0 right-0 bottom-0 left-0 js-close"></div>
</cart-drawer>

{%- if section.settings.cart_terms_page != blank -%}
  <script>
    class CartTerms extends HTMLElement {
      constructor() {
        super();
        this.submitHandler = this.handleSubmit.bind(this);
      }
      handleSubmit(evt) {
        if (!document.getElementById('cart-terms').checked) {
          evt.preventDefault();
          alert(`{{ 'cart.terms.confirmation' | t }}`);
        }
      }
      connectedCallback() {
        document.getElementById('cart-drawer-form').addEventListener('submit', this.submitHandler);
      }
      disconnectedCallback() {
        document.getElementById('cart-drawer-form').removeEventListener('submit', this.submitHandler);
      }
    }
    customElements.define('cart-terms', CartTerms);
  </script>
{%- endif -%}

{%- comment %} ══════════ FREE GIFT ENGINE ══════════ {%- endcomment %}
<script>
(function () {
  'use strict';

  // Aynı script iki kez çalışmasın
  if (window.__ccFreeGiftInit) return;
  window.__ccFreeGiftInit = true;

  var DRAWER_ID = 'cart-drawer';
  var PROP = '_free_gift';

  var busy = false;      // gift sync çalışıyor
  var queued = false;    // sync sırasında yeni tetik geldi
  var timer = null;
  var lockTimer = null;

  // ── Konfig ────────────────────────────────────────────────
  function cfg() {
    var el = document.getElementById(DRAWER_ID);
    if (!el) return null;
    var tiers = [];
    try { tiers = JSON.parse(el.dataset.giftTiers || '[]'); } catch (e) { tiers = []; }
    tiers.sort(function (a, b) { return a.threshold - b.threshold; });
    return {
      el: el,
      tiers: tiers,
      mode: el.dataset.giftMode || 'highest',
      badge: el.dataset.giftBadge || '🎁 Hediye',
      lockLines: el.dataset.giftLock !== 'false',
      qtyUp: el.dataset.giftQtyUp === 'true',
      sectionId: el.dataset.section || 'cart-drawer'
    };
  }

  function getCart() {
    return fetch('/cart.js', {
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    }).then(function (r) { return r.json(); });
  }

  function isGift(item) {
    return !!(item.properties && (item.properties[PROP] === 'true' || item.properties[PROP] === true));
  }

  // Satırın gerçekten ödenen tutarı (line-level + order-level indirim düşülmüş)
  function linePayable(item) {
    var orig = (item.original_line_price != null) ? item.original_line_price : (item.line_price || 0);
    var disc = (item.total_discount != null) ? item.total_discount : 0;
    return Math.max(0, orig - disc);
  }

  // Eşik hesabı: otomatik indirimler sonrası ödenecek tutar, HEDİYELER HARİÇ
  function eligibleTotal(cart) {
    var all = 0, gifts = 0;
    (cart.items || []).forEach(function (i) {
      var p = linePayable(i);
      all += p;
      if (isGift(i)) gifts += p;
    });
    // Sağlama: satır toplamı cart.total_price ile uyuşmuyorsa (order-level
    // indirim satıra yansımamışsa) cart.total_price'ı baz al.
    if (Math.abs(all - cart.total_price) > 5) {
      var giftFinal = 0;
      (cart.items || []).forEach(function (i) {
        if (isGift(i)) giftFinal += (i.final_line_price != null ? i.final_line_price : i.line_price || 0);
      });
      return Math.max(0, cart.total_price - giftFinal);
    }
    return Math.max(0, all - gifts);
  }

  function activeTiers(cart, c) {
    var total = eligibleTotal(cart);
    var passed = c.tiers.filter(function (t) { return total >= t.threshold; });
    if (!passed.length) return [];
    return (c.mode === 'cumulative') ? passed : [passed[passed.length - 1]];
  }

  // ── Cart mutasyonları ─────────────────────────────────────
  function changeLine(key, qty) {
    return fetch('/cart/change.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    });
  }

  function addGift(variantId) {
    var props = {};
    props[PROP] = 'true';
    return fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1, properties: props }] })
    }).then(function (r) {
      if (!r.ok) console.warn('[FreeGift] eklenemedi (stok/variant?):', variantId, r.status);
      return r;
    });
  }

  function applyCode(active) {
    var code = '';
    for (var i = active.length - 1; i >= 0; i--) {
      if (active[i].code) { code = active[i].code; break; }
    }
    if (!code) return Promise.resolve();
    return fetch('/discount/' + encodeURIComponent(code), {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    }).catch(function () {});
  }

  // ── Ana senkron ───────────────────────────────────────────
  function syncGifts() {
    var c = cfg();
    if (!c || !c.tiers.length) return Promise.resolve();
    if (busy) { queued = true; return Promise.resolve(); }
    busy = true;

    return getCart().then(function (cart) {
      var active = activeTiers(cart, c);

      var activeIds = [];
      active.forEach(function (t) {
        (t.variantIds || []).forEach(function (v) { activeIds.push(Number(v)); });
      });

      var allIds = [];
      c.tiers.forEach(function (t) {
        (t.variantIds || []).forEach(function (v) { allIds.push(Number(v)); });
      });

      var giftLines = (cart.items || []).filter(isGift);

      // Çıkacaklar: hediye işaretli ama aktif tier'da olmayan (veya artık tier'da tanımlı olmayan) satırlar
      var toRemove = giftLines.filter(function (i) { return activeIds.indexOf(i.variant_id) === -1; });
      // Sepette duran ve kalması gereken hediyeler
      var present = giftLines.filter(function (i) { return activeIds.indexOf(i.variant_id) !== -1; });
      // Eklenecekler
      var toAdd = activeIds.filter(function (v) {
        return !present.some(function (i) { return i.variant_id === v; });
      });
      // Adet sabitleme (qtyUp kapalıysa hediye adedi 1 olmalı)
      var toFix = c.qtyUp ? [] : present.filter(function (i) { return i.quantity !== 1; });

      if (!toRemove.length && !toAdd.length && !toFix.length) return null;

      var chain = Promise.resolve();
      toRemove.forEach(function (i) { chain = chain.then(function () { return changeLine(i.key, 0); }); });
      toFix.forEach(function (i) { chain = chain.then(function () { return changeLine(i.key, 1); }); });
      toAdd.forEach(function (v) { chain = chain.then(function () { return addGift(v); }); });

      return chain
        .then(function () { return applyCode(active); })
        .then(function () { return refreshDrawer(c); });
    }).catch(function (e) {
      console.warn('[FreeGift] hata:', e);
    }).then(function () {
      busy = false;
      if (queued) { queued = false; schedule(80); }
      lockGiftLines();
    });
  }

  // ── Drawer yenile (Section Rendering API) ─────────────────
  function refreshDrawer(c) {
    return fetch('/?sections=' + encodeURIComponent(c.sectionId), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var html = data[c.sectionId] || data['sections--' + c.sectionId] || Object.values(data)[0];
        if (!html) return;

        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var fresh = tmp.querySelector('#' + DRAWER_ID);
        var live = document.getElementById(DRAWER_ID);
        if (!fresh || !live) return;

        [
          '.drawer__content',
          '.drawer__footer',
          '.drawer__header .js-drawer-header-title'
        ].forEach(function (sel) {
          var n = fresh.querySelector(sel);
          var o = live.querySelector(sel);
          if (n && o) o.innerHTML = n.innerHTML;
        });

        // Header sepet sayacı vb. için temanın kendi event'i
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function () {});
  }

  // ── Hediye satırını kilitle (adet/kaldır yok + etiket) ────
  function findRow(item) {
    var key = item.key;
    var sels = [
      '[data-line-item-key="' + key + '"]',
      '[data-line-key="' + key + '"]',
      '[data-key="' + key + '"]',
      'input[name="updates[' + key + ']"]',
      '[data-quantity-key="' + key + '"]',
      'a[href*="' + key + '"]'
    ];
    var el = null;
    for (var i = 0; i < sels.length; i++) {
      try { el = document.querySelector(sels[i]); } catch (e) { el = null; }
      if (el) break;
    }
    if (!el) {
      try {
        el = document.querySelector('.cart-item a[href*="variant=' + item.variant_id + '"]');
      } catch (e) { el = null; }
    }
    if (!el) return null;
    return el.closest('.cart-item, .cart-item__inner, .drawer__cart-item, li, tr') || el;
  }

  function lockGiftLines() {
    var c = cfg();
    if (!c || !c.lockLines) return;

    getCart().then(function (cart) {
      var gifts = (cart.items || []).filter(isGift);
      if (!gifts.length) return;

      gifts.forEach(function (item) {
        var row = findRow(item);
        if (!row || row.getAttribute('data-free-gift') === 'true') return;
        row.setAttribute('data-free-gift', 'true');

        // Etiket
        if (!row.querySelector('.free-gift-badge')) {
          var titleEl = row.querySelector('.cart-item__title, .cart-item__name, a[href*="/products/"]');
          var badge = document.createElement('span');
          badge.className = 'free-gift-badge';
          badge.textContent = c.badge;
          if (titleEl && titleEl.parentNode) {
            titleEl.parentNode.insertBefore(badge, titleEl.nextSibling);
          } else {
            row.appendChild(badge);
          }
        }

        // Adet/kaldır kontrollerini kaldır (CSS'e ek olarak inline garanti)
        if (!c.qtyUp) {
          row.querySelectorAll(
            'quantity-input, .quantity-input, .cart-item__quantity, .cart-item__qty,' +
            'input[name^="updates"], a[href*="/cart/change"], .cart-item__remove,' +
            '.js-remove-item, [data-cart-remove], button[name="minus"], button[name="plus"]'
          ).forEach(function (n) { n.style.display = 'none'; });

          if (!row.querySelector('.free-gift-qty')) {
            var q = document.createElement('span');
            q.className = 'free-gift-qty';
            q.textContent = '1 adet';
            row.appendChild(q);
          }
        }
      });
    }).catch(function () {});
  }

  function scheduleLock(delay) {
    clearTimeout(lockTimer);
    lockTimer = setTimeout(lockGiftLines, delay == null ? 120 : delay);
  }

  function schedule(delay) {
    clearTimeout(timer);
    timer = setTimeout(syncGifts, delay == null ? 250 : delay);
  }

  // ── Cart mutasyonlarını yakala (fetch + XHR) ──────────────
  var CART_RE = /\/cart\/(add|change|update|clear)(\.js|\.json)?/;

  function installIntercepts() {
    var origFetch = window.fetch;
    window.fetch = function (input, init) {
      var url = (typeof input === 'string') ? input : ((input && input.url) || '');
      var isCart = CART_RE.test(url);
      var trigger = isCart && !busy; // kendi çağrılarımız busy=true iken yapılır
      var p = origFetch.apply(this, arguments);
      if (trigger) {
        p.then(function (r) { if (r && r.ok) schedule(200); return r; }).catch(function () {});
      }
      return p;
    };

    var origOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (m, u) {
      this.__giftUrl = u || '';
      return origOpen.apply(this, arguments);
    };

    var origSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function () {
      if (CART_RE.test(this.__giftUrl || '') && !busy) {
        var self = this;
        this.addEventListener('load', function () {
          if (self.status >= 200 && self.status < 300) schedule(200);
        });
      }
      return origSend.apply(this, arguments);
    };
  }

  // ── Drawer DOM değişince kilidi yeniden uygula ────────────
  function observeDrawer() {
    var el = document.getElementById(DRAWER_ID);
    if (!el || !window.MutationObserver) return;

    new MutationObserver(function () { scheduleLock(120); })
      .observe(el, { childList: true, subtree: true });

    // Drawer açıldığında da kontrol et
    new MutationObserver(function () {
      if (el.getAttribute('aria-hidden') === 'false') { schedule(60); scheduleLock(200); }
    }).observe(el, { attributes: true, attributeFilter: ['aria-hidden', 'class'] });
  }

  // ── Debug yardımcısı: konsolda FreeGift.state() ───────────
  window.FreeGift = {
    sync: syncGifts,
    lock: lockGiftLines,
    config: cfg,
    state: function () {
      var c = cfg();
      return getCart().then(function (cart) {
        var s = {
          tiers: c ? c.tiers : null,
          mode: c ? c.mode : null,
          cart_total_price: cart.total_price,
          eligible_total: c ? eligibleTotal(cart) : null,
          active_tiers: c ? activeTiers(cart, c) : null,
          gift_lines: (cart.items || []).filter(isGift).map(function (i) {
            return { title: i.title, variant_id: i.variant_id, qty: i.quantity, key: i.key };
          })
        };
        console.table ? console.log(s) : console.log(s);
        return s;
      });
    }
  };

  // ── Başlat ────────────────────────────────────────────────
  installIntercepts();

  function boot() {
    observeDrawer();
    syncGifts();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
