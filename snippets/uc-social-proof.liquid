{%- comment -%}
  UC — Sosyal kanıt satırı (puan + satış adedi)

  Tasarımdaki yıldız satırı: 5 yıldız, "4,9 (312 değerlendirme)" bağlantısı
  ve yeşil "● 1.240+ satıldı" rozeti. Fiyatın hemen üstünde durur.

  Veri kaynakları:
  - Puan  : product.metafields.reviews.rating / rating_count (Judge.me yazar)
  - Satış : product.metafields.custom.units_sold (tam sayı, manuel/besleme)

  İkisi de yoksa satır hiç basılmaz. Sayı biçimlendirmesi (1240 → 1.240)
  uc-conversion.js içinde tr-TR yerelinde yapılır; Liquid'de binlik ayracı yok.

  Kullanım:
  {% render 'uc-social-proof' %}
{%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign units_sold = product.metafields.custom.units_sold.value

  assign has_rating = false
  if rating != blank and rating.rating > 0
    assign has_rating = true
  endif

  assign has_sold = false
  if units_sold != blank and units_sold > 0
    assign has_sold = true
  endif

  comment
    rating.liquid ile aynı yuvarlama: yarım yıldızları korur.
  endcomment
  if has_rating
    assign decimal = rating.rating | modulo: 1
    assign stars_rating = rating.rating | floor
    if decimal >= 0.3 and decimal <= 0.7
      assign stars_rating = stars_rating | plus: 0.5
    elsif decimal > 0.7
      assign stars_rating = rating.rating | ceil
    endif
    assign rating_display = rating.rating | round: 1 | replace: '.', ','
  endif
-%}

{%- if has_rating or has_sold -%}
  <div class="uc-social">
    {%- if has_rating -%}
      <div class="rating uc-social__rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating.rating, rating_max: rating.scale_max }}">
        <span class="rating__stars" aria-hidden="true" style="--rating: {{ stars_rating }}; --rating-max: {{ rating.scale_max }};">★★★★★</span>
      </div>

      <a class="uc-social__count" href="#judgeme_product_reviews">
        {{- rating_display }}
        {%- if rating_count != blank and rating_count > 0 %}
          <span class="uc-social__count-label">({{ rating_count }} değerlendirme)</span>
        {%- endif -%}
      </a>
    {%- endif -%}

    {%- if has_sold -%}
      <span class="uc-social__sold">&bull; <span data-uc-num="{{ units_sold }}">{{ units_sold }}</span>+ satıldı</span>
    {%- endif -%}
  </div>
{%- endif -%}
