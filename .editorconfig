root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shopify writes these files itself; don't let editors reformat them.
[{config/settings_data.json,locales/*.json,templates/**.json,sections/*.json}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
