{%- comment -%}
  URBAN Care — Instagram tarzı hikâye şeridi + tam ekran oynatıcı

  Her blok bir hikâye; her hikâyenin en fazla 3 slaytı olabilir.
  Slaytlar düz ayarlarla tanımlanır (slide_1_*, slide_2_*, slide_3_*) çünkü
  Shopify blokları iç içe geçemiyor.

  Mobil: 68px halkalar, oynatıcı tam ekran.
  Masaüstü: 92px halkalar + üst başlık bloğu, oynatıcı telefon oranlı modal.

  Görülen hikâyeler localStorage['uc_viewed_stories'] içinde tutulur ve
  halka gri gösterilir.
{%- endcomment -%}

{%- liquid
  assign duration = section.settings.duration | default: 4
  assign has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_intro = true
  endif
-%}

{%- if section.blocks.size > 0 -%}
<div id="uc-stories-{{ section.id }}" class="ucst" data-duration="{{ duration }}">

  {%- if has_intro -%}
    <div class="ucst__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ucst__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ucst__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ucst__sub">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="ucst__row" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign label = block.settings.label | default: 'Hikâye'
        assign initial = label | slice: 0 | upcase
        assign grad = 'linear-gradient(160deg,' | append: block.settings.grad_from | append: ',' | append: block.settings.grad_to | append: ')'
        assign story_key = block.id
      -%}
      <li class="ucst__cell" {{ block.shopify_attributes }}>
        <button type="button" class="ucst__ring-btn" data-ucst-open="{{ forloop.index0 }}" data-ucst-key="{{ story_key }}">
          <span class="ucst__ring">
            <span class="ucst__cover" style="background:{{ grad }}">
              {%- if block.settings.cover -%}
                <img src="{{ block.settings.cover | image_url: width: 200 }}"
                     width="{{ block.settings.cover.width }}"
                     height="{{ block.settings.cover.height }}"
                     alt="{{ block.settings.cover.alt | default: label | escape }}"
                     loading="lazy">
              {%- else -%}
                <span class="ucst__initial">{{ initial }}</span>
              {%- endif -%}
            </span>
          </span>
          <span class="ucst__label">{{ label | escape }}</span>
        </button>
      </li>
    {%- endfor -%}
  </ul>

  <div class="ucst__player" data-ucst-player hidden>
    <div class="ucst__backdrop" data-ucst-close></div>
    <div class="ucst__stage" role="dialog" aria-modal="true" aria-label="Hikâyeler">
      <div class="ucst__bars" data-ucst-bars></div>

      <div class="ucst__bar-top">
        <span class="ucst__avatar" data-ucst-avatar></span>
        <span class="ucst__title" data-ucst-title></span>
        <button type="button" class="ucst__close" data-ucst-close aria-label="Kapat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <button type="button" class="ucst__tap ucst__tap--prev" data-ucst-prev aria-label="Önceki"></button>
      <button type="button" class="ucst__tap ucst__tap--next" data-ucst-next aria-label="Sonraki"></button>

      {%- for block in section.blocks -%}
        {%- liquid
          assign grad = 'linear-gradient(160deg,' | append: block.settings.grad_from | append: ',' | append: block.settings.grad_to | append: ')'
        -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign k_title = 'slide_' | append: i | append: '_title'
            assign k_text = 'slide_' | append: i | append: '_text'
            assign k_cta = 'slide_' | append: i | append: '_cta'
            assign k_link = 'slide_' | append: i | append: '_link'
            assign k_image = 'slide_' | append: i | append: '_image'
            assign k_product = 'slide_' | append: i | append: '_product'

            assign s_title = block.settings[k_title]
            assign s_text = block.settings[k_text]
            assign s_cta = block.settings[k_cta]
            assign s_link = block.settings[k_link]
            assign s_image = block.settings[k_image]
            assign s_product = block.settings[k_product]
          -%}
          {%- if s_title != blank -%}
            {%- assign s_variant = s_product.selected_or_first_available_variant -%}
            <article class="ucst__slide"
                     data-ucst-slide
                     data-story="{{ forloop.parentloop.index0 }}"
                     data-story-label="{{ block.settings.label | escape }}"
                     data-story-grad="{{ grad }}"
                     style="background:{{ grad }}"
                     hidden>
              {%- if s_image -%}
                <img class="ucst__slide-img"
                     src="{{ s_image | image_url: width: 900 }}"
                     srcset="{{ s_image | image_url: width: 450 }} 450w, {{ s_image | image_url: width: 900 }} 900w"
                     sizes="(min-width: 1024px) 420px, 100vw"
                     width="{{ s_image.width }}"
                     height="{{ s_image.height }}"
                     alt="{{ s_image.alt | default: s_title | escape }}"
                     loading="lazy">
              {%- endif -%}
              <span class="ucst__scrim" aria-hidden="true"></span>
              <div class="ucst__caption">
                <h3 class="ucst__slide-title">{{ s_title | escape }}</h3>
                {%- if s_text != blank -%}
                  <p class="ucst__slide-text">{{ s_text | escape }}</p>
                {%- endif -%}
                {%- if s_product != blank and s_variant and s_variant.available -%}
                  <button type="button"
                          class="ucst__cta ucst__cta--solid"
                          data-ucst-add
                          data-variant="{{ s_variant.id }}">
                    {{ s_cta | default: 'Sepete Ekle' | escape }}
                  </button>
                {%- elsif s_cta != blank -%}
                  <a class="ucst__cta ucst__cta--ghost" href="{{ s_link | default: '#' }}">{{ s_cta | escape }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
#uc-stories-{{ section.id }}{background:{{ section.settings.bg_color }}}
#uc-stories-{{ section.id }} .ucst__intro{display:none}
#uc-stories-{{ section.id }} .ucst__row{display:flex;gap:14px;margin:0;padding:16px;list-style:none;overflow-x:auto;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity;scrollbar-width:none;-ms-overflow-style:none}
#uc-stories-{{ section.id }} .ucst__row::-webkit-scrollbar{width:0;height:0}
#uc-stories-{{ section.id }} .ucst__cell{flex:none;scroll-snap-align:start}
#uc-stories-{{ section.id }} .ucst__ring-btn{display:flex;flex-direction:column;align-items:center;gap:6px;width:70px;padding:0;background:none;border:0;cursor:pointer;color:inherit;font:inherit}
#uc-stories-{{ section.id }} .ucst__ring{display:block;width:68px;height:68px;padding:2.5px;border-radius:50%;background:linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf);transition:transform .18s ease}
#uc-stories-{{ section.id }} .ucst__ring-btn[data-viewed] .ucst__ring{background:#d9d2d6}
#uc-stories-{{ section.id }} .ucst__cover{display:flex;align-items:center;justify-content:center;width:100%;height:100%;border-radius:50%;border:2.5px solid #fff;overflow:hidden;color:#fff}
#uc-stories-{{ section.id }} .ucst__cover img{width:100%;height:100%;object-fit:cover;display:block}
#uc-stories-{{ section.id }} .ucst__initial{font-family:var(--heading-font-family);font-weight:700;font-size:20px}
#uc-stories-{{ section.id }} .ucst__label{max-width:70px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;font-weight:600;color:#1a1a1a}

#uc-stories-{{ section.id }} .ucst__player[hidden]{display:none}
/* Tam ekran oynatıcı, mağazadaki uygulama gömülerinin (ör. Klaviyo bandı) üstünde kalmalı. */
#uc-stories-{{ section.id }} .ucst__player{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center}
#uc-stories-{{ section.id }} .ucst__backdrop{position:absolute;inset:0;background:#111}
#uc-stories-{{ section.id }} .ucst__stage{position:relative;width:100%;max-width:480px;height:100%;overflow:hidden;background:#1a1a1a}
#uc-stories-{{ section.id }} .ucst__slide{position:absolute;inset:0;display:flex;align-items:flex-end}
#uc-stories-{{ section.id }} .ucst__slide[hidden]{display:none}
#uc-stories-{{ section.id }} .ucst__slide-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#uc-stories-{{ section.id }} .ucst__scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.45) 0,transparent 22%,transparent 55%,rgba(0,0,0,.65))}
#uc-stories-{{ section.id }} .ucst__bars{position:absolute;top:10px;left:10px;right:10px;z-index:6;display:flex;gap:4px}
#uc-stories-{{ section.id }} .ucst__bars span{flex:1;height:2.5px;border-radius:2px;background:rgba(255,255,255,.35);overflow:hidden}
#uc-stories-{{ section.id }} .ucst__bars i{display:block;height:100%;width:0;background:#fff}
#uc-stories-{{ section.id }} .ucst__bar-top{position:absolute;top:24px;left:12px;right:12px;z-index:6;display:flex;align-items:center;gap:10px}
#uc-stories-{{ section.id }} .ucst__avatar{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;border:2px solid #fff;background:rgba(255,255,255,.2);color:#fff;font-family:var(--heading-font-family);font-weight:700;font-size:14px}
#uc-stories-{{ section.id }} .ucst__title{flex:1;color:#fff;font-size:14px;font-weight:600;text-shadow:0 1px 3px rgba(0,0,0,.4)}
#uc-stories-{{ section.id }} .ucst__close{padding:4px;background:none;border:0;color:#fff;cursor:pointer}
#uc-stories-{{ section.id }} .ucst__close svg{width:26px;height:26px;display:block}
#uc-stories-{{ section.id }} .ucst__tap{position:absolute;top:60px;bottom:0;z-index:4;background:none;border:0;cursor:pointer}
#uc-stories-{{ section.id }} .ucst__tap--prev{left:0;width:32%}
#uc-stories-{{ section.id }} .ucst__tap--next{right:0;width:68%}
#uc-stories-{{ section.id }} .ucst__caption{position:relative;z-index:6;width:100%;padding:22px 20px calc(28px + env(safe-area-inset-bottom));text-align:center;pointer-events:none}
#uc-stories-{{ section.id }} .ucst__slide-title{margin:0 0 8px;font-family:var(--heading-font-family);font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-.02em;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.4)}
#uc-stories-{{ section.id }} .ucst__slide-text{margin:0 0 16px;font-size:14px;color:rgba(255,255,255,.92);text-shadow:0 1px 6px rgba(0,0,0,.4)}
#uc-stories-{{ section.id }} .ucst__cta{pointer-events:auto;display:inline-block;border-radius:999px;font-weight:700;font-size:15px;text-decoration:none;cursor:pointer}
#uc-stories-{{ section.id }} .ucst__cta--solid{padding:14px 30px;border:0;background:#fff;color:#d81b8c;box-shadow:0 8px 24px rgba(0,0,0,.3)}
#uc-stories-{{ section.id }} .ucst__cta--ghost{padding:13px 30px;border:1.5px solid #fff;background:rgba(255,255,255,.16);color:#fff;backdrop-filter:blur(4px)}

@media(min-width:1024px){
#uc-stories-{{ section.id }}{background:linear-gradient(180deg,{{ section.settings.bg_color }},#fff)}
#uc-stories-{{ section.id }} .ucst__intro{display:block;max-width:1280px;margin:0 auto;padding:44px 40px 0;text-align:center}
#uc-stories-{{ section.id }} .ucst__eyebrow{margin:0 0 8px;font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#d81b8c}
#uc-stories-{{ section.id }} .ucst__heading{margin:0 0 6px;font-family:var(--heading-font-family);font-weight:600;font-size:38px;letter-spacing:-.02em;color:#1a1a1a}
#uc-stories-{{ section.id }} .ucst__sub{margin:0;font-size:15px;color:#6b6b6b}
#uc-stories-{{ section.id }} .ucst__row{max-width:1280px;margin:0 auto;padding:30px 40px 40px;gap:26px;justify-content:center;flex-wrap:wrap;overflow:visible}
#uc-stories-{{ section.id }} .ucst__ring-btn{width:96px;gap:9px}
#uc-stories-{{ section.id }} .ucst__ring{width:92px;height:92px;padding:3px}
#uc-stories-{{ section.id }} .ucst__ring-btn:hover .ucst__ring{transform:scale(1.06)}
#uc-stories-{{ section.id }} .ucst__cover{border-width:3px}
#uc-stories-{{ section.id }} .ucst__initial{font-size:28px}
#uc-stories-{{ section.id }} .ucst__label{max-width:none;font-size:13px}
#uc-stories-{{ section.id }} .ucst__backdrop{background:rgba(0,0,0,.82)}
#uc-stories-{{ section.id }} .ucst__stage{width:420px;max-width:92vw;height:88vh;max-height:820px;border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.5)}
#uc-stories-{{ section.id }} .ucst__bars{top:12px;left:12px;right:12px}
#uc-stories-{{ section.id }} .ucst__bars span{height:3px}
#uc-stories-{{ section.id }} .ucst__bar-top{top:26px;left:14px;right:14px}
#uc-stories-{{ section.id }} .ucst__caption{padding:26px 24px 32px}
#uc-stories-{{ section.id }} .ucst__slide-title{font-size:26px}
}
{% endstyle %}

<script>
(function(){
  var root = document.getElementById('uc-stories-{{ section.id }}');
  if (!root || root.dataset.ucstReady) return;
  root.dataset.ucstReady = '1';

  var STORE_KEY = 'uc_viewed_stories';
  var player  = root.querySelector('[data-ucst-player]');
  var bars    = root.querySelector('[data-ucst-bars]');
  var avatar  = root.querySelector('[data-ucst-avatar]');
  var titleEl = root.querySelector('[data-ucst-title]');
  var slides  = Array.prototype.slice.call(root.querySelectorAll('[data-ucst-slide]'));
  var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-ucst-open]'));
  var duration = (parseFloat(root.dataset.duration) || 4) * 1000;

  // Hikâye indeksine göre slaytları grupla. Slaytı olmayan bloklar atlanır,
  // bu yüzden oynatıcı sırası (order) buton sırasından farklı olabilir.
  var groups = {};
  slides.forEach(function(el){
    var k = el.dataset.story;
    (groups[k] = groups[k] || []).push(el);
  });
  var order = Object.keys(groups).sort(function(a, b){ return a - b; });
  var btnFor = {};
  buttons.forEach(function(b){ btnFor[b.dataset.ucstOpen] = b; });

  var storyPos = 0, slidePos = 0, timer = null, progress = 0, startedAt = 0;

  function readViewed(){
    try { return JSON.parse(localStorage.getItem(STORE_KEY) || '{}') || {}; } catch (e) { return {}; }
  }
  function paintViewed(){
    var v = readViewed();
    buttons.forEach(function(b){
      if (v[b.dataset.ucstKey]) b.setAttribute('data-viewed', '');
      else b.removeAttribute('data-viewed');
    });
  }
  function markViewed(btn){
    if (!btn) return;
    var v = readViewed();
    v[btn.dataset.ucstKey] = true;
    try { localStorage.setItem(STORE_KEY, JSON.stringify(v)); } catch (e) {}
    paintViewed();
  }

  function currentSlides(){ return groups[order[storyPos]] || []; }

  function renderBars(){
    var list = currentSlides();
    bars.innerHTML = '';
    list.forEach(function(_, i){
      var wrap = document.createElement('span');
      var fill = document.createElement('i');
      fill.style.width = i < slidePos ? '100%' : '0';
      wrap.appendChild(fill);
      bars.appendChild(wrap);
    });
  }

  function paintProgress(){
    var fill = bars.children[slidePos] && bars.children[slidePos].firstChild;
    if (fill) fill.style.width = progress + '%';
  }

  function show(){
    var list = currentSlides();
    slides.forEach(function(el){ el.hidden = true; });
    var active = list[slidePos];
    if (!active) return;
    active.hidden = false;
    titleEl.textContent = active.dataset.storyLabel || '';
    avatar.textContent = (active.dataset.storyLabel || '').charAt(0).toUpperCase();
    progress = 0;
    paintProgress();
    startTimer();
  }

  // İlerleme, tik sayısına değil geçen gerçek süreye göre hesaplanır: sekme arka
  // plana alınıp zamanlayıcı kısıtlandığında bile slayt doğru anda ilerler.
  function startTimer(){
    stopTimer();
    startedAt = Date.now();
    timer = setInterval(function(){
      progress = (Date.now() - startedAt) / duration * 100;
      if (progress >= 100) next();
      else paintProgress();
    }, 50);
  }
  function stopTimer(){ if (timer) { clearInterval(timer); timer = null; } }

  function open(i){
    if (i < 0 || i >= order.length) return;
    storyPos = i;
    slidePos = 0;
    markViewed(btnFor[order[storyPos]]);
    player.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    renderBars();
    show();
  }
  function close(){
    stopTimer();
    player.hidden = true;
    document.documentElement.style.overflow = '';
    slides.forEach(function(el){ el.hidden = true; });
  }
  function next(){
    if (slidePos < currentSlides().length - 1) {
      var done = bars.children[slidePos] && bars.children[slidePos].firstChild;
      if (done) done.style.width = '100%';
      slidePos++;
      show();
    } else if (storyPos < order.length - 1) {
      open(storyPos + 1);
    } else {
      close();
    }
  }
  function prev(){
    if (slidePos > 0) { slidePos--; renderBars(); show(); }
    else if (storyPos > 0) { open(storyPos - 1); }
    else { progress = 0; paintProgress(); startTimer(); }
  }

  buttons.forEach(function(btn){
    var pos = order.indexOf(btn.dataset.ucstOpen);
    if (pos === -1) { (btn.closest('.ucst__cell') || btn).hidden = true; return; }
    btn.addEventListener('click', function(){ open(pos); });
  });
  root.querySelectorAll('[data-ucst-close]').forEach(function(el){
    el.addEventListener('click', close);
  });
  root.querySelector('[data-ucst-next]').addEventListener('click', next);
  root.querySelector('[data-ucst-prev]').addEventListener('click', prev);

  document.addEventListener('keydown', function(e){
    if (player.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  });

  root.addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('[data-ucst-add]') : null;
    if (!btn || btn.disabled) return;
    var vid = btn.getAttribute('data-variant');
    if (!vid) return;
    stopTimer();
    btn.disabled = true;
    var label = btn.textContent;
    btn.textContent = 'Ekleniyor...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(vid), quantity: 1 }] })
    })
    .then(function(r){ if (!r.ok) throw 0; return r.json(); })
    .then(function(){
      btn.textContent = 'Eklendi ✓';
      close();
      try { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } })); } catch (e) {}
      setTimeout(function(){ btn.textContent = label; btn.disabled = false; }, 1800);
    })
    .catch(function(){ btn.textContent = label; btn.disabled = false; startTimer(); });
  });

  paintViewed();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hikâyeler",
  "tag": "section",
  "class": "cc-uc-stories",
  "settings": [
    { "type": "paragraph", "content": "Üst başlık alanı yalnızca masaüstünde görünür." },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "BUGÜNÜN HİKÂYELERİ" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Cildine ve saçına iyi gelen her şey" },
    { "type": "text", "id": "text", "label": "Açıklama", "default": "Bir hikâyeye dokun, kampanyaları ve rutinleri keşfet." },
    { "type": "range", "id": "duration", "min": 2, "max": 8, "step": 1, "unit": "sn", "label": "Slayt süresi", "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Zemin rengi", "default": "#fff5f9" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Hikâye",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Yeni" },
        { "type": "image_picker", "id": "cover", "label": "Kapak görseli", "info": "Boşsa etiketin ilk harfi degrade üzerinde gösterilir." },
        { "type": "color", "id": "grad_from", "label": "Degrade başlangıcı", "default": "#ff9ecb" },
        { "type": "color", "id": "grad_to", "label": "Degrade bitişi", "default": "#d81b8c" },

        { "type": "header", "content": "1. Slayt" },
        { "type": "text", "id": "slide_1_title", "label": "Başlık", "default": "Yeni Gelenler" },
        { "type": "text", "id": "slide_1_text", "label": "Alt metin", "default": "Bu haftanın lansmanları" },
        { "type": "image_picker", "id": "slide_1_image", "label": "Görsel" },
        { "type": "product", "id": "slide_1_product", "label": "Ürün", "info": "Seçilirse buton 'Sepete Ekle' olur ve doğrudan sepete ekler." },
        { "type": "text", "id": "slide_1_cta", "label": "Buton metni", "default": "Keşfet →" },
        { "type": "url", "id": "slide_1_link", "label": "Buton bağlantısı", "info": "Ürün seçilmediğinde kullanılır." },

        { "type": "header", "content": "2. Slayt" },
        { "type": "text", "id": "slide_2_title", "label": "Başlık", "info": "Boş bırakılırsa bu slayt gösterilmez." },
        { "type": "text", "id": "slide_2_text", "label": "Alt metin" },
        { "type": "image_picker", "id": "slide_2_image", "label": "Görsel" },
        { "type": "product", "id": "slide_2_product", "label": "Ürün" },
