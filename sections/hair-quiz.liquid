{%- comment -%}
  URBAN Care — Saç Testi v2
  8 soru · Cinsiyet bazlı rutin · İkincil seri + çift çapraz satış bloğu
  Mantık: hair-quiz.js → decideSeries() & buildRoutine()
  Görsel: intro ekranında isteğe bağlı desktop + mobil görsel (görsel yoksa sade bg)
{%- endcomment -%}

{%- comment -%} Tüm seriler — her collection'dan max 10 ürün çekilir {%- endcomment -%}
{%- assign quiz_handles = 'expert-biotin-caffeine,rosemary-clove,glycolic-retinol,argan-oil-keratin,intense-keratin,hyaluronic-collagen,hibiscus-shea-butter,style-guide,turunculasma-karsiti,bond-plex,apple-cider,kind-rituals,brezilya-keratin,perfecting,shake-n-repair' | split: ',' -%}

{%- assign has_desktop_img = false -%}
{%- assign has_mobile_img  = false -%}
{%- if section.settings.intro_image_desktop != blank -%}{%- assign has_desktop_img = true -%}{%- endif -%}
{%- if section.settings.intro_image_mobile  != blank -%}{%- assign has_mobile_img  = true -%}{%- endif -%}
{%- assign has_img = false -%}
{%- if has_desktop_img or has_mobile_img -%}{%- assign has_img = true -%}{%- endif -%}

<section class="hquiz{% if has_img %} hquiz--has-image{% endif %}" id="hquiz-{{ section.id }}" data-quiz>

  {%- comment -%} Görsel varsa intro ekranını 2 sütunlu layout'a sar {%- endcomment -%}
  {%- if has_img -%}
  <div class="hquiz__hero-wrap" data-img-pos="{{ section.settings.image_position | default: 'left' }}" style="--hq-img-fit:{{ section.settings.image_fit | default: 'cover' }};">

    {{- '<!-- Görsel sütunu -->' }}
    <div class="hquiz__hero-img">
      {%- if has_mobile_img -%}
        <img class="hquiz__img hquiz__img--mobile"
             src="{{ section.settings.intro_image_mobile | image_url: width: 800 }}"
             alt="{{ section.settings.heading | escape }}"
             loading="lazy" width="800" height="1000">
      {%- endif -%}
      {%- if has_desktop_img -%}
        <img class="hquiz__img hquiz__img--desktop"
             src="{{ section.settings.intro_image_desktop | image_url: width: 1200 }}"
             alt="{{ section.settings.heading | escape }}"
             loading="lazy" width="1200" height="900">
      {%- endif -%}
      {%- if has_mobile_img == false and has_desktop_img -%}
        {{- '<!-- Sadece desktop var, mobilde de göster -->' }}
      {%- endif -%}
    </div>

    {{- '<!-- Quiz sütunu -->' }}
    <div class="hquiz__hero-quiz">
  {%- endif -%}

  <div class="hquiz__inner{% unless has_img %} wrap{% endunless %}">
    <div class="hquiz__progress"><span data-bar></span></div>

    {{- '<!-- EKRAN 0: GİRİŞ -->' }}
    <div class="hquiz__intro" data-screen="intro">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="muted">{{ section.settings.subtext }}</p>
      <button class="btn btn--brand" data-start>{{ section.settings.start_label }}</button>
    </div>

    {{- '<!-- EKRAN 1: SORULAR -->' }}
    <div class="hquiz__step" data-screen="step" hidden>
      <p class="hquiz__count"><span data-step-no>1</span> / <span data-step-total>8</span></p>
      <h2 class="hquiz__q" data-q></h2>
      <p class="hquiz__hint" data-hint></p>
      <div class="hquiz__opts" data-opts></div>
      <button class="hquiz__back" data-back hidden>{{ section.settings.back_label }}</button>
    </div>

    {{- '<!-- EKRAN 2: SONUÇ -->' }}
    <div class="hquiz__result" data-screen="result" hidden>

      {{- '<!-- 2a: Ana Rutin -->' }}
      <div class="hquiz__section hquiz__section--primary">
        <span class="eyebrow" data-result-eyebrow>{{ section.settings.result_eyebrow }}</span>
        <h2 data-result-title>{{ section.settings.result_title }}</h2>
        <p class="muted" data-result-sub></p>
        <div class="hquiz__cards" data-cards></div>
        <div class="hquiz__routine-cta">
          <button class="btn btn--brand" data-add-all>{{ section.settings.add_all_label }}</button>
          <button class="hquiz__restart" data-restart>{{ section.settings.restart_label }}</button>
        </div>
      </div>

      {{- '<!-- 2b: Rutinini Tamamla -->' }}
      <div class="hquiz__section hquiz__section--complete" data-extras hidden>
        <h3>{{ section.settings.extras_title }}</h3>
        <p class="muted">{{ section.settings.extras_sub }}</p>
        <div class="hquiz__cards" data-extra-cards></div>
        <button class="btn btn--brand hquiz__add-extras" data-add-all-extras>{{ section.settings.extras_add_label }}</button>
      </div>

      {{- '<!-- 2c: Saç Şekillendirmeni Tamamla -->' }}
      <div class="hquiz__section hquiz__section--styling" data-styling hidden>
        <h3>{{ section.settings.styling_title }}</h3>
        <p class="muted">{{ section.settings.styling_sub }}</p>
        <div class="hquiz__cards" data-styling-cards></div>
        <button class="btn btn--brand" data-add-all-styling>{{ section.settings.styling_add_label }}</button>
      </div>

    </div>{{- '<!-- /hquiz__result -->' }}
  </div>

  {%- if has_img -%}
    </div>{{- '<!-- /hquiz__hero-quiz -->' }}
  </div>{{- '<!-- /hquiz__hero-wrap -->' }}
  {%- endif -%}

  {{- '<!-- Ürün verisi -->' }}
  <script type="application/json" data-products>
  {
    {%- for h in quiz_handles -%}
      {%- assign col = collections[h] -%}
      "{{ h }}": [
        {%- for p in col.products limit: 10 -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {
            "id": {{ v.id | default: p.variants.first.id }},
            "title": {{ p.title | json }},
            "url": {{ p.url | json }},
            "img": {{ p.featured_image | image_url: width: 400 | json }},
            "price": {{ p.price | money | json }},
            "type": {{ p.type | json }},
            "subtype": {{ p.metafields.custom.product_subtype.value | default: "" | json }},
            "tags": {{ p.tags | json }},
            "ki": {{ p.metafields.custom.key_ingredients.value | default: p.metafields.custom.short_description.value | json }},
            "avail": {{ p.available | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
  </script>
</section>

{{ 'hair-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hair-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Saç Testi",
  "settings": [
    { "type": "header",   "content": "Giriş görseli" },
    { "type": "image_picker", "id": "intro_image_desktop", "label": "Desktop görseli",  "info": "Önerilen en boy: 1200×900 px. Boş bırakırsan sadece arka plan rengi görünür." },
    { "type": "image_picker", "id": "intro_image_mobile",  "label": "Mobil görseli",    "info": "Önerilen en boy: 800×1000 px. Boş bırakırsan desktop görseli kullanılır." },
    { "type": "select",   "id": "image_position",          "label": "Görsel konumu (desktop)", "default": "left",
      "options": [
        { "value": "left",  "label": "Sol" },
        { "value": "right", "label": "Sağ" }
      ]
    },
    { "type": "select",   "id": "image_fit",               "label": "Görsel kırpma", "default": "cover",
      "options": [
        { "value": "cover",   "label": "Kırp (cover)" },
        { "value": "contain", "label": "Tamamını göster (contain)" }
      ]
    },

    { "type": "header",   "content": "Giriş ekranı" },
    { "type": "text",     "id": "eyebrow",        "label": "Üst etiket",  "default": "SAÇINA ÖZEL" },
    { "type": "text",     "id": "heading",         "label": "Başlık",      "default": "Saç Testi" },
    { "type": "textarea", "id": "subtext",         "label": "Açıklama",    "default": "8 kısa soru. Saçına en uygun bakım rutinini birlikte bulalım — 90 saniyeden kısa." },
    { "type": "text",     "id": "start_label",     "label": "Başlat",      "default": "Teste başla →" },
    { "type": "text",     "id": "back_label",      "label": "Geri",        "default": "← Geri" },

    { "type": "header",   "content": "Sonuç — Ana Rutin" },
    { "type": "text",     "id": "result_eyebrow",  "label": "Üst etiket",  "default": "SENİN İÇİN" },
    { "type": "text",     "id": "result_title",    "label": "Başlık",      "default": "Kişisel Rutinin" },
    { "type": "text",     "id": "add_all_label",   "label": "Sepete ekle", "default": "Tüm rutini sepete ekle" },
    { "type": "text",     "id": "restart_label",   "label": "Tekrar al",   "default": "Testi tekrar al" },

    { "type": "header",   "content": "Rutinini Tamamla" },
    { "type": "text",     "id": "extras_title",    "label": "Başlık",      "default": "Rutinini Tamamla" },
    { "type": "textarea", "id": "extras_sub",      "label": "Alt metin",   "default": "Verdiğin cevaplara göre rutinini güçlendirecek ürünler." },
    { "type": "text",     "id": "extras_add_label","label": "Ekle butonu", "default": "Tümünü sepete ekle" },

    { "type": "header",   "content": "Saç Şekillendirmeni Tamamla" },
    { "type": "text",     "id": "styling_title",   "label": "Başlık",      "default": "Saç Şekillendirmeni Tamamla" },
    { "type": "textarea", "id": "styling_sub",     "label": "Alt metin",   "default": "Saçını şekillendirmek için sana özel Style Guide önerileri." },
    { "type": "text",     "id": "styling_add_label","label": "Ekle butonu","default": "Şekillendirici ürünleri sepete ekle" }
  ],
  "presets": [{ "name": "Saç Testi" }]
}
{% endschema %}
