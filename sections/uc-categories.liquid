{%- comment -%}
  URBAN Care — kategori kısayolları

  İki yerleşim var, ikisi de aynı bloklardan:
  - "badge": mobilde yatay kaydırılan 64px daire rozetler, masaüstünde kare ızgara.
  - "banner": degrade/görsel zeminli büyük kartlar (mobil 2 sütun 3:4, masaüstü 2:1).

  Blok bir koleksiyona bağlanır; başlık ve görsel boş bırakılırsa
  koleksiyonun kendi başlığı ve öne çıkan görseli kullanılır.
{%- endcomment -%}

{%- liquid
  assign layout = section.settings.layout | default: 'badge'
  assign per_row = section.settings.columns_desktop | default: 2
-%}

<div id="uc-cats-{{ section.id }}" class="uc-cats uc-cats--{{ layout }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="uc-cats__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="uc-cats__list uc-scroll" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = collections[block.settings.collection]
        assign title = block.settings.title | default: collection.title
        assign image = block.settings.image | default: collection.featured_image
        assign url = collection.url | default: '#'
        assign grad = 'linear-gradient(150deg,' | append: block.settings.grad_from | append: ',' | append: block.settings.grad_to | append: ')'
      -%}
      <li class="uc-cats__item" {{ block.shopify_attributes }}>
        <a class="uc-cats__link" href="{{ url }}" {% if layout == 'banner' %}style="background:{{ grad }}"{% endif %}>
          <span class="uc-cats__thumb">
            {%- if image -%}
              <img src="{{ image | image_url: width: 900 }}"
                   srcset="{{ image | image_url: width: 300 }} 300w,
                           {{ image | image_url: width: 900 }} 900w"
                   sizes="{% if layout == 'banner' %}(min-width: 768px) 50vw, 50vw{% else %}(min-width: 768px) 20vw, 64px{% endif %}"
                   width="{{ image.width }}"
                   height="{{ image.height }}"
                   alt="{{ image.alt | default: title | escape }}"
                   loading="lazy">
            {%- endif -%}
          </span>
          <span class="uc-cats__copy">
            <span class="uc-cats__label">{{ title | escape }}</span>
            {%- if layout == 'banner' and section.settings.cta_label != blank -%}
              <span class="uc-cats__cta">{{ section.settings.cta_label | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% style %}
#uc-cats-{{ section.id }} .uc-cats__heading{margin:0;padding:22px 16px 0;font-family:var(--heading-font-family);font-weight:600;font-size:22px;letter-spacing:-.02em;color:#1a1a1a;text-align:center}
#uc-cats-{{ section.id }} .uc-cats__list::-webkit-scrollbar{width:0;height:0}

/* --- Rozet yerleşimi --- */
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__list{display:flex;gap:10px;margin:0;padding:18px 16px 4px;list-style:none;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__item{flex:none}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__link{display:flex;flex-direction:column;align-items:center;gap:7px;text-decoration:none;color:#1a1a1a}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__thumb{display:block;width:64px;height:64px;border-radius:50%;overflow:hidden;background:{{ section.settings.tile_color }}}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__thumb img{width:100%;height:100%;object-fit:cover;display:block}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__label{font-size:11.5px;text-align:center}
@media(min-width:768px){
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__list{display:grid;grid-template-columns:repeat({{ section.blocks.size | at_least: 1 }},1fr);gap:20px;padding:40px;overflow:visible}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__link{gap:12px}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__thumb{width:100%;height:auto;aspect-ratio:1/1;border-radius:16px}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__label{font-size:14px;font-weight:500}
#uc-cats-{{ section.id }}.uc-cats--badge .uc-cats__link:hover .uc-cats__label{color:#d81b8c}
}

/* --- Banner yerleşimi --- */
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:0;padding:6px 16px 32px;list-style:none}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__link{position:relative;display:flex;align-items:flex-end;aspect-ratio:3/4;padding:16px;border-radius:16px;overflow:hidden;color:#fff;text-decoration:none}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__thumb{position:absolute;inset:0}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__thumb img{width:100%;height:100%;object-fit:cover;display:block}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__link::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.45))}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__copy{position:relative;z-index:1}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__label{display:block;font-family:var(--heading-font-family);font-weight:700;font-size:17px;letter-spacing:.02em;text-transform:uppercase}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__cta{display:none;font-size:14px;font-weight:600;opacity:.9}
@media(min-width:1024px){
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__list{max-width:1280px;margin:0 auto;grid-template-columns:repeat({{ per_row }},1fr);gap:24px;padding:0 40px 60px}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__link{aspect-ratio:2/1;padding:32px;border-radius:22px}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__label{font-size:26px}
#uc-cats-{{ section.id }}.uc-cats--banner .uc-cats__cta{display:block}
#uc-cats-{{ section.id }} .uc-cats__heading{padding:0 40px 24px;font-size:32px}
}
{% endstyle %}

{% schema %}
{
  "name": "Kategoriler",
  "tag": "section",
  "class": "cc-uc-cats",
  "settings": [
    { "type": "select", "id": "layout", "label": "Yerleşim", "default": "badge", "options": [
      { "value": "badge", "label": "Rozet (yatay kaydırma)" },
      { "value": "banner", "label": "Banner kartlar" }
    ] },
    { "type": "text", "id": "heading", "label": "Başlık (opsiyonel)" },
    { "visible_if": "{{ section.settings.layout == 'banner' }}",
      "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Masaüstü sütun sayısı", "default": 2 },
    { "visible_if": "{{ section.settings.layout == 'banner' }}",
      "type": "text", "id": "cta_label", "label": "Kart bağlantı metni (yalnızca masaüstü)", "default": "Keşfet →" },
    { "visible_if": "{{ section.settings.layout == 'badge' }}",
      "type": "color", "id": "tile_color", "label": "Kutu zemini", "default": "#fff5f9" }
  ],
  "blocks": [
    { "type": "category", "name": "Kategori", "settings": [
      { "type": "collection", "id": "collection", "label": "Koleksiyon" },
      { "type": "text", "id": "title", "label": "Başlık", "info": "Boşsa koleksiyon adı kullanılır." },
      { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Boşsa koleksiyonun öne çıkan görseli kullanılır." },
      { "type": "header", "content": "Banner yerleşimi" },
      { "type": "color", "id": "grad_from", "label": "Degrade başlangıcı", "default": "#f857a6", "info": "Görsel yoksa kartın zemini olur." },
      { "type": "color", "id": "grad_to", "label": "Degrade bitişi", "default": "#c5006a" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Kategoriler", "blocks": [ {"type":"category"}, {"type":"category"}, {"type":"category"}, {"type":"category"}, {"type":"category"} ] } ],
  "disabled_on": { "groups": ["header","footer","aside"] }
}
{% endschema %}
