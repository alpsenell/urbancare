{%- comment -%} URBAN Care - personalized rail: greeting + reorder (logged-in) + for-you (Shopify recommendations). No brand tier/seri input required. Cart adds via standard form POST (theme-agnostic). {%- endcomment -%}
{%- liquid
  assign seed_id = ''
  assign has_reorder = false
  if customer and customer.orders_count > 0
    for order in customer.orders
      for line in order.line_items
        if line.product and line.product.available
          assign seed_id = line.product.id
          assign has_reorder = true
          break
        endif
      endfor
      if seed_id != ''
        break
      endif
    endfor
  endif
  if seed_id == ''
    assign bs = collections['cok-satanlar'].products | first
    if bs
      assign seed_id = bs.id
    endif
  endif
-%}
<div class="section-background">
 <div class="flex container">
  <div id="uc-personal-{{ section.id }}" class="section section--standard section--border-radius color-scheme color-scheme--{{ section.settings.color_scheme | default: 'scheme-1' }}" data-seed="{{ seed_id }}">
    <div class="container container--text">
      {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      <h2 class="h1">{%- if customer.first_name != blank -%}Merhaba {{ customer.first_name | escape }}{%- else -%}{{ section.settings.heading | default: 'Sana Özel' | escape }}{%- endif -%}</h2>
      {%- if section.settings.text != blank -%}<p class="uc-personal-sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    {%- if has_reorder -%}
    <div class="uc-tabs" role="tablist">
      <button type="button" class="uc-tab is-active" data-tab="reorder">Son Aldıkların</button>
      <button type="button" class="uc-tab" data-tab="reco">Senin İçin</button>
    </div>
    <div class="uc-panel" data-panel="reorder">
      <div class="uc-rail-scroll">
        {%- assign seen = '' -%}
        {%- assign n = 0 -%}
        {%- for order in customer.orders -%}
          {%- for line in order.line_items -%}
            {%- if n >= 8 -%}{%- break -%}{%- endif -%}
            {%- assign prod = line.product -%}
            {%- if prod and prod.available and line.variant and line.variant.available -%}
              {%- assign key = line.variant_id | append: ',' -%}
              {%- unless seen contains key -%}
                {%- assign seen = seen | append: key -%}
                {%- assign n = n | plus: 1 -%}
                <div class="uc-mini">
                  <a class="uc-mini__img" href="{{ prod.url }}">{%- if line.image -%}<img loading="lazy" width="300" height="300" src="{{ line.image | image_url: width: 300 }}" alt="{{ prod.title | escape }}">{%- elsif prod.featured_image -%}<img loading="lazy" width="300" height="300" src="{{ prod.featured_image | image_url: width: 300 }}" alt="{{ prod.title | escape }}">{%- endif -%}</a>
                  <a class="uc-mini__t" href="{{ prod.url }}">{{ prod.title | escape }}</a>
                  <div class="uc-mini__p">{{ line.variant.price | money }}</div>
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ line.variant_id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="btn btn--primary uc-mini__btn">Tekrar Al</button>
                  </form>
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if n >= 8 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    <div class="uc-panel" data-panel="reco"{% if has_reorder %} hidden{% endif %}>
      <div class="uc-rail-scroll" data-uc-reco></div>
      <p class="uc-empty" data-uc-reco-empty hidden>Biraz gezindikçe sana özel öneriler burada belirecek.</p>
    </div>
  </div>
 </div>
</div>

{% style %}
#shopify-section-{{ section.id }} .uc-personal-sub{opacity:.72;margin-top:6px}
#shopify-section-{{ section.id }} .uc-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
#shopify-section-{{ section.id }} .uc-tab{border:1px solid rgba(0,0,0,.15);background:transparent;color:inherit;padding:9px 16px;border-radius:999px;font-weight:600;font-size:.9rem;cursor:pointer;font-family:inherit}
#shopify-section-{{ section.id }} .uc-tab.is-active{background:#d81b8c;border-color:#d81b8c;color:#fff}
#shopify-section-{{ section.id }} .uc-rail-scroll{display:grid;grid-auto-flow:column;grid-auto-columns:58%;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}
@media(min-width:768px){#shopify-section-{{ section.id }} .uc-rail-scroll{grid-auto-flow:row;grid-template-columns:repeat(4,1fr);grid-auto-columns:auto;overflow:visible}}
#shopify-section-{{ section.id }} .uc-mini{scroll-snap-align:start;display:flex;flex-direction:column;gap:6px;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:14px;padding:10px}
#shopify-section-{{ section.id }} .uc-mini__img{display:block;aspect-ratio:1/1;border-radius:10px;overflow:hidden;background:#f5f0ec}
#shopify-section-{{ section.id }} .uc-mini__img img{width:100%;height:100%;object-fit:contain}
#shopify-section-{{ section.id }} .uc-mini__t{font-weight:600;font-size:.88rem;line-height:1.3;color:inherit;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.3em}
#shopify-section-{{ section.id }} .uc-mini__p{font-weight:800;color:#d81b8c}
#shopify-section-{{ section.id }} .uc-mini__btn{margin-top:auto;width:100%;justify-content:center}
#shopify-section-{{ section.id }} .uc-empty{opacity:.7;padding:8px 0}
{% endstyle %}

<script>
(function(){
  var root=document.getElementById('uc-personal-{{ section.id }}');
  if(!root) return;
  var tabs=root.querySelectorAll('.uc-tab');
  tabs.forEach(function(t){t.addEventListener('click',function(){
    tabs.forEach(function(x){x.classList.remove('is-active');});t.classList.add('is-active');
    root.querySelectorAll('.uc-panel').forEach(function(p){p.hidden=p.getAttribute('data-panel')!==t.getAttribute('data-tab');});
  });});
  var seed=root.getAttribute('data-seed');
  var wrap=root.querySelector('[data-uc-reco]');
  var empty=root.querySelector('[data-uc-reco-empty]');
  var fmt;try{fmt=new Intl.NumberFormat('tr-TR',{style:'currency',currency:'TRY'});}catch(e){fmt=null;}
  function money(c){if(c==null)return '';return fmt?fmt.format(c/100):((c/100).toFixed(2)+' TL');}
  function card(p){
    var url=p.url||('/products/'+p.handle);
    var img=p.featured_image||(p.images&&p.images[0])||'';
    var vid=null;if(p.variants&&p.variants.length){for(var i=0;i<p.variants.length;i++){if(p.variants[i].available){vid=p.variants[i].id;break;}}if(!vid)vid=p.variants[0].id;}
    var d=document.createElement('div');d.className='uc-mini';
    var h='<a class="uc-mini__img" href="'+url+'">'+(img?'<img loading="lazy" src="'+img+'" alt="">':'')+'</a>'+'<a class="uc-mini__t" href="'+url+'">'+(p.title||'')+'</a>'+'<div class="uc-mini__p">'+money(p.price)+'</div>';
    if(vid){h+='<form action="/cart/add" method="post"><input type="hidden" name="id" value="'+vid+'"><input type="hidden" name="quantity" value="1"><button type="submit" class="btn btn--primary uc-mini__btn">Sepete Ekle</button></form>';}
    d.innerHTML=h;return d;
  }
  if(!seed){if(empty)empty.hidden=false;return;}
  fetch('/recommendations/products.json?product_id='+seed+'&intent=related&limit=10')
    .then(function(r){return r.ok?r.json():null;})
    .then(function(d){var list=(d&&d.products)?d.products:[];if(!list.length){if(empty)empty.hidden=false;return;}list.forEach(function(p){wrap.appendChild(card(p));});})
    .catch(function(){if(empty)empty.hidden=false;});
})();
</script>

{% schema %}
{
  "name": "URBAN Care Kişisel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst etiket", "default": "SANA ÖZEL" },
    { "type": "text", "id": "heading", "label": "Başlık (misafir)", "default": "Sana Özel" },
    { "type": "text", "id": "text", "label": "Alt metin", "default": "Senin için derledik." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "presets": [ { "name": "URBAN Care Kişisel" } ],
  "disabled_on": { "groups": ["header","footer","aside"] }
}
{% endschema %}
