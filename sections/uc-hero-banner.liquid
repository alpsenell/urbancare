{%- comment -%}
  URBAN Care — büyük kampanya banner'ı

  Mobil: tam ekran (88vh), görselin üzerinde alttan yukarı açılan perde,
  tek CTA ve sağ üstte indirim rozeti.
  Masaüstü: 1280px içinde 600px yüksekliğinde yuvarlatılmış full-bleed banner,
  soldan sağa açılan perde ve iki CTA.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign scrim = section.settings.scrim_color | default: '#fff0f7'
-%}

<div id="uc-hb-{{ section.id }}" class="uchb">
  <div class="uchb__frame">
    {%- if image_mobile -%}
      <img class="uchb__img uchb__img--mobile"
           src="{{ image_mobile | image_url: width: 900 }}"
           srcset="{{ image_mobile | image_url: width: 450 }} 450w,
                   {{ image_mobile | image_url: width: 900 }} 900w"
           sizes="100vw"
           width="{{ image_mobile.width }}"
           height="{{ image_mobile.height }}"
           alt="{{ image_mobile.alt | default: section.settings.heading | escape }}"
           loading="eager"
           fetchpriority="high">
    {%- endif -%}

    {%- if image -%}
      <img class="uchb__img uchb__img--desktop"
           src="{{ image | image_url: width: 2000 }}"
           srcset="{{ image | image_url: width: 1000 }} 1000w,
                   {{ image | image_url: width: 2000 }} 2000w"
           sizes="(min-width: 768px) 1280px, 100vw"
           width="{{ image.width }}"
           height="{{ image.height }}"
           alt="{{ image.alt | default: section.settings.heading | escape }}"
           loading="eager"
           fetchpriority="high">
    {%- elsif image_mobile == blank -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'uchb__placeholder' }}
    {%- endif -%}

    <span class="uchb__scrim" aria-hidden="true"></span>

    {%- if section.settings.badge_text != blank -%}
      <span class="uchb__badge">{{ section.settings.badge_text | escape }}</span>
    {%- endif -%}

    <div class="uchb__content">
      {%- if section.settings.pill_text != blank -%}
        <span class="uchb__pill">{{ section.settings.pill_text | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="uchb__heading uchb__heading--mobile">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.heading_desktop != blank -%}
        <h2 class="uchb__heading uchb__heading--desktop">{{ section.settings.heading_desktop | escape }}</h2>
      {%- endif -%}

      {%- comment -%} richtext bir <p> döndürdüğü için sarmalayıcı <div> olmalı; <p> içinde <p> geçersiz. {%- endcomment -%}
      {%- if section.settings.text != blank -%}
        <div class="uchb__text uchb__text--mobile">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.text_desktop != blank -%}
        <div class="uchb__text uchb__text--desktop">{{ section.settings.text_desktop }}</div>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="uchb__buttons">
          {%- if section.settings.button_1_label != blank -%}
            <a class="uchb__btn uchb__btn--primary" href="{{ section.settings.button_1_link | default: '#' }}">
              {{- section.settings.button_1_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="uchb__btn uchb__btn--outline" href="{{ section.settings.button_2_link | default: '#' }}">
              {{- section.settings.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
#uc-hb-{{ section.id }} .uchb__frame{position:relative;display:flex;align-items:flex-end;height:88vh;min-height:560px;overflow:hidden;background:{{ scrim }}}
#uc-hb-{{ section.id }} .uchb__img,#uc-hb-{{ section.id }} .uchb__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
#uc-hb-{{ section.id }} .uchb__img--desktop{display:none}
#uc-hb-{{ section.id }} .uchb__scrim{position:absolute;inset:0;background:linear-gradient(180deg,transparent,{{ scrim | color_modify: 'alpha', 0.55 }} 30%,{{ scrim | color_modify: 'alpha', 0.97 }} 68%)}
#uc-hb-{{ section.id }} .uchb__badge{position:absolute;top:20px;right:16px;z-index:2;display:flex;align-items:center;justify-content:center;width:76px;height:76px;border-radius:50%;background:#d81b8c;color:#fff;font-family:var(--heading-font-family);font-weight:700;font-size:20px;box-shadow:0 10px 24px rgba(216,27,140,.32)}
#uc-hb-{{ section.id }} .uchb__content{position:relative;z-index:2;width:100%;padding:44px 22px 34px}
#uc-hb-{{ section.id }} .uchb__pill{display:inline-flex;align-items:center;gap:6px;padding:6px 13px;border-radius:999px;background:#fff;color:#d81b8c;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 3px 10px rgba(216,27,140,.14)}
#uc-hb-{{ section.id }} .uchb__heading{margin:14px 0 8px;max-width:14ch;font-family:var(--heading-font-family);font-weight:600;font-size:36px;line-height:1.08;letter-spacing:-.02em;color:#1a1a1a}
#uc-hb-{{ section.id }} .uchb__heading--desktop,#uc-hb-{{ section.id }} .uchb__text--desktop{display:none}
#uc-hb-{{ section.id }} .uchb__text{margin:0 0 22px;max-width:32ch;font-size:15px;line-height:1.5;color:#5c4a53}
#uc-hb-{{ section.id }} .uchb__text p{margin:0}
#uc-hb-{{ section.id }} .uchb__text strong{color:#d81b8c}
#uc-hb-{{ section.id }} .uchb__buttons{display:flex;gap:12px;flex-wrap:wrap}
#uc-hb-{{ section.id }} .uchb__btn{display:inline-flex;align-items:center;gap:7px;padding:15px 32px;border-radius:999px;font-weight:700;font-size:15px;text-decoration:none;transition:background-color .15s ease,color .15s ease}
#uc-hb-{{ section.id }} .uchb__btn--primary{background:#d81b8c;color:#fff;border:1.5px solid #d81b8c;box-shadow:0 8px 20px rgba(216,27,140,.28)}
#uc-hb-{{ section.id }} .uchb__btn--primary:hover{background:#9e0055;border-color:#9e0055;color:#fff}
#uc-hb-{{ section.id }} .uchb__btn--outline{display:none;background:#fff;color:#d81b8c;border:1.5px solid #d81b8c}
#uc-hb-{{ section.id }} .uchb__btn--outline:hover{background:#d81b8c;color:#fff}

@media(min-width:1024px){
#uc-hb-{{ section.id }}{padding:0 40px 8px}
#uc-hb-{{ section.id }} .uchb__frame{max-width:1280px;margin:0 auto;height:auto;min-height:600px;align-items:center;border-radius:32px}
#uc-hb-{{ section.id }} .uchb__img--mobile{display:none}
#uc-hb-{{ section.id }} .uchb__img--desktop{display:block}
#uc-hb-{{ section.id }} .uchb__scrim{background:linear-gradient(90deg,{{ scrim | color_modify: 'alpha', 0.96 }} 0%,{{ scrim | color_modify: 'alpha', 0.82 }} 42%,{{ scrim | color_modify: 'alpha', 0.25 }} 68%,transparent 100%)}
#uc-hb-{{ section.id }} .uchb__badge{top:36px;right:44px;width:104px;height:104px;font-size:26px;box-shadow:0 14px 34px rgba(216,27,140,.35)}
#uc-hb-{{ section.id }} .uchb__content{max-width:640px;padding:0 64px}
#uc-hb-{{ section.id }} .uchb__pill{padding:8px 16px;font-size:13px}
#uc-hb-{{ section.id }} .uchb__heading{margin:22px 0 18px;max-width:15ch;font-size:60px;line-height:1.04;letter-spacing:-.03em}
#uc-hb-{{ section.id }} .uchb__text{margin:0 0 34px;max-width:42ch;font-size:19px;line-height:1.55}
#uc-hb-{{ section.id }} .uchb__heading--desktop,#uc-hb-{{ section.id }} .uchb__text--desktop{display:block}
#uc-hb-{{ section.id }} .uchb__heading--mobile,#uc-hb-{{ section.id }} .uchb__text--mobile{display:none}
#uc-hb-{{ section.id }} .uchb__btn{padding:18px 40px;font-size:17px}
#uc-hb-{{ section.id }} .uchb__btn--primary{box-shadow:0 12px 30px rgba(216,27,140,.3)}
#uc-hb-{{ section.id }} .uchb__btn--outline{display:inline-flex;padding:18px 34px}
}
{% endstyle %}

{% schema %}
{
  "name": "Kampanya Banner",
  "tag": "section",
  "class": "cc-uc-hero-banner",
  "settings": [
    { "type": "text", "id": "pill_text", "label": "Rozet metni", "default": "✨ Yeni Sezon" },
    { "type": "text", "id": "badge_text", "label": "İndirim rozeti (daire)", "default": "%40", "info": "Boş bırakılırsa daire gösterilmez." },
    { "type": "header", "content": "Metinler" },
    { "type": "text", "id": "heading", "label": "Başlık (mobil)", "default": "Dolgun saçlar için yeni seri" },
    { "type": "text", "id": "heading_desktop", "label": "Başlık (masaüstü)", "default": "Hyaluronic Collagen ile dolgun saçlar" },
    { "type": "richtext", "id": "text", "label": "Açıklama (mobil)", "default": "<p>Hyaluronic Collagen sette <strong>%40'a varan</strong> indirim.</p>" },
    { "type": "richtext", "id": "text_desktop", "label": "Açıklama (masaüstü)", "default": "<p>Nemlendiren, güçlendiren ve hacim veren yeni bakım serisiyle tanış. Tüm sette <strong>%40'a varan</strong> indirim.</p>" },
    { "type": "header", "content": "Butonlar" },
    { "type": "text", "id": "button_1_label", "label": "1. buton metni", "default": "Hemen Keşfet →" },
    { "type": "url", "id": "button_1_link", "label": "1. buton bağlantısı" },
    { "type": "text", "id": "button_2_label", "label": "2. buton metni (yalnızca masaüstü)", "default": "Setleri Gör" },
    { "type": "url", "id": "button_2_link", "label": "2. buton bağlantısı" },
    { "type": "header", "content": "Görseller" },
    { "type": "image_picker", "id": "image", "label": "Görsel (masaüstü)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Görsel (mobil)", "info": "Boş bırakılırsa masaüstü görseli kullanılır." },
    { "type": "color", "id": "scrim_color", "label": "Perde rengi", "default": "#fff0f7", "info": "Metnin okunurluğu için görselin üzerine uygulanan degrade rengi." }
  ],
  "presets": [ { "name": "Kampanya Banner" } ],
  "disabled_on": { "groups": ["header","footer","aside"] }
}
{% endschema %}
