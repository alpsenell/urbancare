{%- comment -%}
  URBAN Care — "Kendi Rutinini Oluştur" (adım adım rutin kurucu)

  Her blok bir adım; her adımda en fazla 3 ürün seçeneği olur.
  Ziyaretçi adım başına bir ürün seçer, alttaki koyu bantta toplam anlık güncellenir
  ve tek butonla seçilen ürünlerin hepsi sepete eklenir.

  Mobil: adımlar alt alta, seçenekler yatay kaydırmalı.
  Masaüstü: adımlar 3 sütun, seçenekler alt alta.
{%- endcomment -%}

{%- liquid
  assign steps = 0
  for block in section.blocks
    assign has_option = false
    for i in (1..3)
      assign key = 'product_' | append: i
      assign p = block.settings[key]
      if p != blank and p.selected_or_first_available_variant.available
        assign has_option = true
      endif
    endfor
    if has_option
      assign steps = steps | plus: 1
    endif
  endfor
-%}

{%- if steps > 0 -%}
<div id="uc-routine-{{ section.id }}" class="ucrt" data-money-format="{{ shop.money_format | escape }}">
  <div class="ucrt__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="ucrt__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ucrt__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ucrt__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ucrt__steps">
      {%- for block in section.blocks -%}
        {%- assign picked = false -%}
        {%- capture options -%}
          {%- for i in (1..3) -%}
            {%- liquid
              assign key = 'product_' | append: i
              assign p = block.settings[key]
              assign v = p.selected_or_first_available_variant
            -%}
            {%- if p != blank and v and v.available -%}
              {%- assign is_first = false -%}
              {%- unless picked -%}
                {%- assign is_first = true -%}
                {%- assign picked = true -%}
              {%- endunless -%}
              <button type="button"
                      class="ucrt__opt"
                      data-ucrt-opt
                      data-price="{{ v.price }}"
                      data-variant="{{ v.id }}"
                      aria-pressed="{% if is_first %}true{% else %}false{% endif %}">
                <span class="ucrt__thumb">
                  {%- if p.featured_media -%}
                    <img src="{{ p.featured_media | image_url: width: 300 }}"
                         width="150" height="150"
                         alt="{{ p.title | escape }}"
                         loading="lazy">
                  {%- endif -%}
                  <span class="ucrt__check" aria-hidden="true">✓</span>
                </span>
                <span class="ucrt__opt-copy">
                  <span class="ucrt__name">{{ p.title }}</span>
                  <span class="ucrt__price">{{ v.price | money }}</span>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if picked -%}
          <div class="ucrt__step" data-ucrt-step {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <div class="ucrt__step-label">{{ block.settings.label | escape }}</div>
            {%- endif -%}
            <div class="ucrt__options">{{ options }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ucrt__summary">
      <div>
        <div class="ucrt__total-label">{{ section.settings.total_label | escape }}</div>
        <div class="ucrt__total" data-ucrt-total>{{ 0 | money }}</div>
      </div>
      <button type="button" class="ucrt__btn" data-ucrt-add>
        {{ section.settings.button_label | default: 'Rutini Sepete Ekle' | escape }}
      </button>
    </div>
  </div>
</div>

{% style %}
#uc-routine-{{ section.id }}{padding:30px 16px}
#uc-routine-{{ section.id }} .ucrt__head{margin-bottom:18px;text-align:center}
#uc-routine-{{ section.id }} .ucrt__eyebrow{margin:0 0 6px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#d81b8c}
#uc-routine-{{ section.id }} .ucrt__heading{margin:0;font-family:var(--heading-font-family);font-weight:600;font-size:22px;letter-spacing:-.02em;color:#1a1a1a}
#uc-routine-{{ section.id }} .ucrt__steps{display:flex;flex-direction:column;gap:18px}
#uc-routine-{{ section.id }} .ucrt__step-label{margin-bottom:9px;font-size:12px;font-weight:700;letter-spacing:.02em;color:#c5006a}
#uc-routine-{{ section.id }} .ucrt__options{display:flex;gap:10px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;scrollbar-width:none;-ms-overflow-style:none}
#uc-routine-{{ section.id }} .ucrt__options::-webkit-scrollbar{width:0;height:0}
#uc-routine-{{ section.id }} .ucrt__opt{flex:0 0 46%;display:block;padding:10px;border:1.5px solid #eedde8;border-radius:14px;background:#fff;text-align:left;color:inherit;font:inherit;cursor:pointer;transition:border-color .15s ease,background-color .15s ease}
#uc-routine-{{ section.id }} .ucrt__opt[aria-pressed="true"]{border-color:#d81b8c;background:#fff0f7}
#uc-routine-{{ section.id }} .ucrt__thumb{position:relative;display:block;aspect-ratio:1/1;margin-bottom:8px;border-radius:9px;overflow:hidden;background:#faf1f6}
#uc-routine-{{ section.id }} .ucrt__thumb img{width:100%;height:100%;object-fit:cover;display:block}
#uc-routine-{{ section.id }} .ucrt__check{position:absolute;top:6px;right:6px;display:none;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:#d81b8c;color:#fff;font-size:12px}
#uc-routine-{{ section.id }} .ucrt__opt[aria-pressed="true"] .ucrt__check{display:flex}
#uc-routine-{{ section.id }} .ucrt__name{display:block;height:31px;overflow:hidden;font-size:12px;font-weight:600;line-height:1.3;color:#1a1a1a}
#uc-routine-{{ section.id }} .ucrt__price{display:block;margin-top:4px;font-size:12.5px;font-weight:700;color:#d81b8c}
#uc-routine-{{ section.id }} .ucrt__summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:20px;padding:14px 18px;border-radius:16px;background:#1a1a1a}
#uc-routine-{{ section.id }} .ucrt__total-label{font-size:11px;letter-spacing:.04em;color:rgba(255,255,255,.6)}
#uc-routine-{{ section.id }} .ucrt__total{font-family:var(--heading-font-family);font-size:20px;font-weight:800;color:#fff}
#uc-routine-{{ section.id }} .ucrt__btn{padding:12px 20px;border:0;border-radius:999px;background:#d81b8c;color:#fff;font-size:13.5px;font-weight:700;cursor:pointer;transition:background-color .15s ease}
#uc-routine-{{ section.id }} .ucrt__btn:hover{background:#9e0055}
#uc-routine-{{ section.id }} .ucrt__btn[disabled]{opacity:.7;cursor:default}

@media(min-width:1024px){
#uc-routine-{{ section.id }}{padding:60px 40px}
#uc-routine-{{ section.id }} .ucrt__inner{max-width:1280px;margin:0 auto}
#uc-routine-{{ section.id }} .ucrt__head{margin-bottom:36px}
#uc-routine-{{ section.id }} .ucrt__eyebrow{font-size:12px;letter-spacing:.16em}
#uc-routine-{{ section.id }} .ucrt__heading{font-size:32px}
#uc-routine-{{ section.id }} .ucrt__steps{display:grid;grid-template-columns:repeat({{ steps }},1fr);gap:28px}
#uc-routine-{{ section.id }} .ucrt__step-label{margin-bottom:14px;font-size:14px}
#uc-routine-{{ section.id }} .ucrt__options{flex-direction:column;gap:12px;overflow:visible}
#uc-routine-{{ section.id }} .ucrt__opt{flex:none;display:flex;align-items:center;gap:14px;padding:12px;border-radius:16px}
#uc-routine-{{ section.id }} .ucrt__thumb{flex-shrink:0;width:64px;height:64px;margin-bottom:0;aspect-ratio:auto;border-radius:11px}
#uc-routine-{{ section.id }} .ucrt__opt-copy{min-width:0}
#uc-routine-{{ section.id }} .ucrt__name{height:auto;font-size:14px}
#uc-routine-{{ section.id }} .ucrt__price{margin-top:5px;font-size:14px}
#uc-routine-{{ section.id }} .ucrt__summary{margin-top:32px;padding:22px 32px;border-radius:20px}
#uc-routine-{{ section.id }} .ucrt__total-label{font-size:12px}
#uc-routine-{{ section.id }} .ucrt__total{font-size:28px}
#uc-routine-{{ section.id }} .ucrt__btn{padding:15px 32px;font-size:16px}
}
{% endstyle %}

<script>
(function(){
  var root = document.getElementById('uc-routine-{{ section.id }}');
  if (!root || root.dataset.ucrtReady) return;
  root.dataset.ucrtReady = '1';

  var format   = root.dataset.moneyFormat || {{ shop.money_format | json }};
  var totalEl  = root.querySelector('[data-ucrt-total]');
  var addBtn   = root.querySelector('[data-ucrt-add]');
  var steps    = Array.prototype.slice.call(root.querySelectorAll('[data-ucrt-step]'));

  function group(cents, sep){
    return String(cents).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
  }

  // shop.money_format içindeki standart tokenları destekler.
  function money(cents){
    return format.replace(/\{\{\s*(\w+)\s*\}\}/g, function(_, token){
      var whole = Math.floor(cents / 100);
      var frac  = ('0' + Math.round(cents % 100)).slice(-2);
      switch (token) {
        case 'amount_no_decimals':                     return group(whole, ',');
        case 'amount_with_comma_separator':            return group(whole, '.') + ',' + frac;
        case 'amount_no_decimals_with_comma_separator':return group(whole, '.');
        case 'amount_with_apostrophe_separator':       return group(whole, "'") + '.' + frac;
        default:                                       return group(whole, ',') + '.' + frac;
      }
    });
  }

  function selected(){
    return steps.map(function(step){ return step.querySelector('[aria-pressed="true"]'); }).filter(Boolean);
  }

  function refresh(){
    var sum = selected().reduce(function(t, el){ return t + (parseInt(el.dataset.price, 10) || 0); }, 0);
    totalEl.textContent = money(sum);
  }

  root.addEventListener('click', function(e){
    var opt = e.target.closest ? e.target.closest('[data-ucrt-opt]') : null;
    if (!opt) return;
    var step = opt.closest('[data-ucrt-step]');
    if (!step) return;
    step.querySelectorAll('[data-ucrt-opt]').forEach(function(el){
      el.setAttribute('aria-pressed', el === opt ? 'true' : 'false');
    });
    refresh();
  });

  addBtn.addEventListener('click', function(){
    var items = selected().map(function(el){ return { id: Number(el.dataset.variant), quantity: 1 }; });
    if (!items.length || addBtn.disabled) return;

    addBtn.disabled = true;
    var label = addBtn.textContent;
    addBtn.textContent = 'Ekleniyor...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function(r){ if (!r.ok) throw 0; return r.json(); })
    .then(function(){
      addBtn.textContent = 'Eklendi ✓';
      try { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } })); } catch (err) {}
      setTimeout(function(){ addBtn.textContent = label; addBtn.disabled = false; }, 1800);
    })
    .catch(function(){ addBtn.textContent = label; addBtn.disabled = false; });
  });

  refresh();
})();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding:28px;text-align:center;color:rgba(0,0,0,.45);font-size:13px;border:1px dashed rgba(197,0,106,.25);border-radius:14px;max-width:760px;margin-inline:auto;background:#fdf5f9;">
    Rutin kurucu gizli. Görünmesi için en az bir adımda stokta olan bir ürün seçili olmalı.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Rutin Kurucu",
  "tag": "section",
  "class": "cc-uc-routine",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "3 ADIMDA RUTİN" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kendi Rutinini Oluştur" },
    { "type": "text", "id": "total_label", "label": "Toplam etiketi", "default": "RUTİN TOPLAMI" },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Rutini Sepete Ekle" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Adım",
      "settings": [
        { "type": "text", "id": "label", "label": "Adım başlığı", "default": "1 · Temizle" },
        { "type": "product", "id": "product_1", "label": "1. seçenek" },
        { "type": "product", "id": "product_2", "label": "2. seçenek" },
        { "type": "product", "id": "product_3", "label": "3. seçenek" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Rutin Kurucu", "blocks": [ {"type":"step"}, {"type":"step"}, {"type":"step"} ] }
  ],
  "disabled_on": { "groups": ["header","footer","aside"] }
}
{% endschema %}
