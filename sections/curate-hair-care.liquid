    { "type": "text",   "id": "subheading", "label": "Alt başlık" },
    { "type": "text",   "id": "testimonial_eyebrow", "label": "Influencer üst etiketi", "default": "GERÇEK DENEYİM" },
    { "type": "text",   "id": "shop_suffix", "label": "Ürün başlığı eki", "default": "Serisini Keşfet", "info": "Örn: 'Kıvırcık' + 'Serisini Keşfet'" },
    { "type": "text",   "id": "explore_all_label", "label": "Tümünü Keşfet buton metni (boş = gizli)", "default": "Tümünü Keşfet" },

    { "type": "header", "content": "Renk & Stil" },
    { "type": "color",  "id": "accent_color", "label": "Vurgu rengi (magenta)", "default": "#C5006A" },
    { "type": "color",  "id": "section_bg",   "label": "Arka plan rengi",       "default": "#fdf5f9" },
    { "type": "header", "content": "Boşluk" },
    { "type": "range",  "id": "pad_top",    "label": "Üst boşluk (px)", "min": 0, "max": 120, "step": 8, "default": 64 },
    { "type": "range",  "id": "pad_bottom", "label": "Alt boşluk (px)", "min": 0, "max": 120, "step": 8, "default": 64 }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "hair_type",
      "name": "Saç Tipi",
      "settings": [
        { "type": "header",       "content": "Tab Görseli" },
        { "type": "text",         "id": "tab_label",  "label": "Tab etiketi",  "default": "Kıvırcık Saç" },
        { "type": "image_picker", "id": "tab_image",  "label": "Tab görseli (yuvarlak, kare yükle)" },
        { "type": "color",        "id": "tab_color",  "label": "Görsel yoksa bg rengi", "default": "#f0e0eb" },
        { "type": "text",         "id": "tab_emoji",  "label": "Görsel yoksa emoji",    "default": "🌀" },

        { "type": "header",       "content": "Influencer" },
        { "type": "text",         "id": "influencer_name",  "label": "İsim",    "default": "Ayşe K." },
        { "type": "image_picker", "id": "influencer_image", "label": "Fotoğraf (4:5 önerilir)" },
        { "type": "url",          "id": "video_url",        "label": "Video URL (.mp4 — foto yerine geçer)" },
        { "type": "textarea",     "id": "quote",            "label": "Alıntı",  "default": "Urban Care sayesinde saçlarım inanılmaz derecede canlandı!" },

        { "type": "header",       "content": "Stat Satırı (isim altı)" },
        { "type": "text",   "id": "stat1_icon",  "label": "Stat 1 emoji",  "default": "👤" },
        { "type": "text",   "id": "stat1_label", "label": "Stat 1 etiket", "default": "YAŞ" },
        { "type": "text",   "id": "stat1_val",   "label": "Stat 1 değer",  "default": "24" },
        { "type": "text",   "id": "stat2_icon",  "label": "Stat 2 emoji",  "default": "💬" },
        { "type": "text",   "id": "stat2_label", "label": "Stat 2 etiket", "default": "SORUN" },
        { "type": "text",   "id": "stat2_val",   "label": "Stat 2 değer",  "default": "Kırılganlık" },
        { "type": "text",   "id": "stat3_icon",  "label": "Stat 3 emoji",  "default": "🌀" },
        { "type": "text",   "id": "stat3_label", "label": "Stat 3 etiket", "default": "TİP" },
        { "type": "text",   "id": "stat3_val",   "label": "Stat 3 değer",  "default": "Kıvırcık 3A" },

        { "type": "header",       "content": "Konum (opsiyonel)" },
        { "type": "text",   "id": "meta3_label", "label": "Konum etiketi (kullanılmıyor)", "default": "Şehir" },
        { "type": "text",   "id": "meta3_val",   "label": "Şehir / konum",  "default": "İstanbul" },

        { "type": "header",         "content": "Ürün Serisi" },
        { "type": "collection",     "id": "collection",       "label": "Koleksiyon" },
        { "type": "text",           "id": "collection_title", "label": "Seri adı (boş = tab adı)" },
        { "type": "range",          "id": "products_count",   "label": "Ürün sayısı",   "min": 2, "max": 8, "step": 1, "default": 4 },
        { "type": "text",           "id": "card_badge",       "label": "Kart rozeti (sağ üst, opsiyonel)", "info": "Örn: TOP RATED" },
        { "type": "text",           "id": "card_strip_label", "label": "Kart alt şeridi (opsiyonel)", "info": "Örn: KIVIRCIK İÇİN" }
      ]
    }
  ],
  "presets": [
    {
      "name": "UC Saç Tipine Göre Keşfet",
      "blocks": [
        { "type": "hair_type", "settings": { "tab_label": "Kıvırcık Saç", "tab_emoji": "🌀", "influencer_name": "Ayşe K.", "quote": "Kıvırcık saçlarım hiç bu kadar iyi görünmemişti!" } },
        { "type": "hair_type", "settings": { "tab_label": "Dalgalı Saç",  "tab_emoji": "〰️", "influencer_name": "Zeynep A.", "quote": "Dalgalarım artık çok daha belirgin ve bakımlı." } },
        { "type": "hair_type", "settings": { "tab_label": "Düz Saç",      "tab_emoji": "💇",  "influencer_name": "Merve B.", "quote": "Düz saçım artık çok daha parlak ve sağlıklı!" } }
      ]
    }
  ]
}
{% endschema %}
