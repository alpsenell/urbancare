{%- unless request.page_type == 'cart' or settings.cart_type == 'page' -%}
  {%- comment %}theme-check-disable NestedSnippet{% endcomment -%}
  {%- render 'cart-drawer' -%}
  {%- comment %}theme-check-enable NestedSnippet{% endcomment -%}
{%- endunless -%}

{% schema %}
{
  "name": "Cart drawer",
  "class": "cc-cart-drawer",
  "settings": [
    {
      "type": "header",
      "content": "Cart items"
    },
    {
      "type": "checkbox",
      "id": "show_backorder_text",
      "label": "Show backorder text",
      "default": true,
      "info": "Only shows for products which use Shopify inventory tracking and can be purchased when out of stock."
    },
    {
      "type": "header",
      "content": "🎁 Ücretsiz Hediye Ayarları"
    },
    {
      "type": "select",
      "id": "gift_mode",
      "label": "Hediye modu",
      "options": [
        { "value": "highest", "label": "Sadece en yüksek tier (öncekini çıkar)" },
        { "value": "cumulative", "label": "Kümülatif (tüm eşikleri topla)" }
      ],
      "default": "highest",
      "info": "Kümülatif modda ₺500 ve ₺1000 eşiğini geçen müşteri her iki hediyeyi de alır."
    },
    {
      "type": "header",
      "content": "Tier 1"
    },
    {
      "type": "checkbox",
      "id": "gift_tier_1_active",
      "label": "Tier 1 aktif",
      "default": false
    },
    {
      "type": "number",
      "id": "gift_tier_1_amount",
      "label": "Minimum sepet tutarı (₺)",
      "default": 500
    },
    {
      "type": "product",
      "id": "gift_tier_1_product_1",
      "label": "Hediye ürün 1"
    },
    {
      "type": "product",
      "id": "gift_tier_1_product_2",
      "label": "Hediye ürün 2 (opsiyonel)"
    },
    {
      "type": "product",
      "id": "gift_tier_1_product_3",
      "label": "Hediye ürün 3 (opsiyonel)"
    },
    {
      "type": "text",
      "id": "gift_tier_1_code",
      "label": "İndirim kodu (opsiyonel)",
      "info": "Bu tier açıldığında otomatik uygulanır. Shopify'da bu kodu oluşturmayı unutma."
