<script>
  (function(){
    var root = document.getElementById('uc-flash-{{ section.id }}');
    if (!root || root.dataset.inited) return;
    root.dataset.inited = '1';
    var design = !!(window.Shopify && Shopify.designMode);

    function pad(n){ return (n < 10 ? '0' : '') + n; }

    var cards = Array.prototype.slice.call(root.querySelectorAll('.uc-flash__card'));
    var live = cards.length;
    var pendingStart = [];

    function hideCard(card){
      if (card.style.display !== 'none'){
        card.style.display = 'none';
        live--;
        if (live <= 0 && !design) root.style.display = 'none';
      }
    }
    function revealCard(card){
      if (card.style.display === 'none'){
        card.style.display = '';
        live++;
        if (root.style.display === 'none') root.style.display = '';
      }
    }

    cards.forEach(function(card){
      var startStr = card.getAttribute('data-start');
      var endStr   = card.getAttribute('data-end');
      var doCount  = card.getAttribute('data-countdown') === '1';
      var timer    = card.querySelector('[data-timer]');
      var start    = startStr ? new Date(startStr.replace(' ', 'T')) : null;
      var end      = endStr   ? new Date(endStr.replace(' ', 'T'))   : null;
      var hasValidStart = start && !isNaN(start.getTime());
      var started  = design || !hasValidStart || Date.now() >= start.getTime();
      var iv;

      function tick(){
        if (!end || isNaN(end.getTime())) return;
        var diff = end.getTime() - Date.now();
        if (diff <= 0){
          if (iv) clearInterval(iv);
          if (!design) hideCard(card);
          return;
        }
        var s = Math.floor(diff / 1000);
        var d = Math.floor(s / 86400); s -= d * 86400;
        var h = Math.floor(s / 3600);  s -= h * 3600;
        var m = Math.floor(s / 60);    s -= m * 60;
        if (timer){
          timer.hidden = false;
          var dd = timer.querySelector('[data-days]');
          if (d > 0){ if (dd){ dd.hidden = false; dd.querySelector('[data-d]').textContent = d; } }
          else if (dd){ dd.hidden = true; }
          var hh = timer.querySelector('[data-h]');
          var mm = timer.querySelector('[data-m]');
          var ss = timer.querySelector('[data-s]');
          if (hh) hh.textContent = pad(h);
          if (mm) mm.textContent = pad(m);
          if (ss) ss.textContent = pad(s);
        }
      }

      function startCountdownIfNeeded(){
        if (doCount && end && !isNaN(end.getTime())){ tick(); iv = setInterval(tick, 1000); }
      }

      if (!started){
        card.style.display = 'none';
        live--;
        pendingStart.push({ card: card, start: start, onStart: startCountdownIfNeeded });
      } else {
        startCountdownIfNeeded();
      }
    });

    if (live <= 0 && !design) root.style.display = 'none';

    if (pendingStart.length){
      var startIv = setInterval(function(){
        var now = Date.now();
        pendingStart = pendingStart.filter(function(item){
          if (!item.start || isNaN(item.start.getTime()) || now >= item.start.getTime()){
            revealCard(item.card); item.onStart(); return false;
          }
          return true;
        });
        if (!pendingStart.length) clearInterval(startIv);
      }, 1000);
    }

    /* ── CART ADD ── */
    function openCartDrawer(){
      // Beautify teması öncelik sırası:
      // 1. Yerel cart-drawer custom element'i varsa aç
      var drawerEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
      if (drawerEl && typeof drawerEl.open === 'function'){ drawerEl.open(); return; }

      // 2. Beautify global theme object
      if (window.theme && window.theme.cart && typeof window.theme.cart.open === 'function'){
        window.theme.cart.open(); return;
      }

      // 3. Yaygın custom event'ler — hepsini birden fırlat
      var events = ['cart:open', 'theme:cart:open', 'cart:refresh', 'cart:updated'];
      events.forEach(function(name){
        try { document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { open: true } })); } catch(e){}
      });

      // 4. Hiçbiri çalışmazsa /cart sayfasına git (son çare)
      setTimeout(function(){
        var cartLink = document.querySelector('a[href="/cart"]');
        if (cartLink){ cartLink.click(); }
      }, 150);
    }

    root.addEventListener('click', function(e){
      var b = e.target && e.target.closest ? e.target.closest('[data-add]') : null;
      if (!b) return;
      e.preventDefault();
      var card = b.closest('.uc-flash__card');
      if (!card) return;

      // Variant ID — string olarak gönder, Number() NaN riski var
      var VID  = (card.getAttribute('data-variant') || '').trim();
      var CODE = card.getAttribute('data-code');
      if (!VID || b.disabled) return;

      var variantId = parseInt(VID, 10);
      if (isNaN(variantId)){ console.error('[UC Flash] Geçersiz variant ID:', VID); return; }

      b.disabled = true;
      var orig = b.textContent;
      b.textContent = 'Ekleniyor…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(function(r){
        if (!r.ok) return r.json().then(function(d){ throw new Error(d.description || r.status); });
        return r.json();
      })
      .then(function(){
        if (CODE){
          // İndirim kodu varsa: ekle → koda redirect → cart
          window.location.href = '/discount/' + encodeURIComponent(CODE) + '?redirect=/cart';
        } else {
          b.textContent = 'Eklendi ✓';
          openCartDrawer();
          setTimeout(function(){ b.textContent = orig; b.disabled = false; }, 1800);
        }
      })
      .catch(function(err){
        console.error('[UC Flash] Sepete eklenemedi:', err);
        b.textContent = 'Hata — tekrar dene';
        setTimeout(function(){ b.textContent = orig; b.disabled = false; }, 2000);
      });
    });
  })();
  </script>