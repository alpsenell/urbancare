{%- comment -%}
  URBAN Care — "Birlikte Daha Güçlü" set kartı

  Bloklardaki ürünlerin fiyatları toplanır, indirim yüzdesi uygulanır ve
  üstü çizili toplam ile set fiyatı yan yana gösterilir. Buton tüm ürünleri
  tek seferde sepete ekler; indirim kodu girildiyse kod otomatik uygulanır.

  Mobil: dikey (metin üstte, ürünler altta).
  Masaüstü: 2 sütun (metin solda, ürünler sağda).
{%- endcomment -%}

{%- liquid
  assign pct = section.settings.discount_percent | default: 0
  assign total = 0
  assign shown = 0
  assign variant_ids = ''

  for block in section.blocks
    assign p = block.settings.product
    assign v = p.selected_or_first_available_variant
    if p != blank and v and v.available
      assign total = total | plus: v.price
      assign shown = shown | plus: 1
      assign variant_ids = variant_ids | append: v.id | append: ','
    endif
  endfor

  assign bundle_price = total
  if pct > 0
    assign keep = 100 | minus: pct
    assign bundle_price = total | times: keep | divided_by: 100
  endif
  assign variant_ids = variant_ids | split: ',' | join: ','
-%}

{%- if shown > 0 -%}
<div id="uc-bundle-{{ section.id }}" class="ucbn">
  <div class="ucbn__card">
    <div class="ucbn__copy">
      {%- if pct > 0 -%}
        <span class="ucbn__pill">{{ section.settings.pill_text | replace: '[pct]', pct | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ucbn__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ucbn__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="ucbn__buy">
        <div class="ucbn__prices">
          {%- if pct > 0 -%}
            <span class="ucbn__orig">{{ total | money }}</span>
          {%- endif -%}
          <span class="ucbn__price">{{ bundle_price | money }}</span>
        </div>
        <button type="button"
                class="ucbn__btn"
                data-ucbn-add
                data-variants="{{ variant_ids }}"
                data-code="{{ section.settings.discount_code | escape }}">
          {{ section.settings.button_label | default: 'Seti Sepete Ekle' | escape }}
        </button>
      </div>
    </div>

    <div class="ucbn__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign v = p.selected_or_first_available_variant
        -%}
        {%- if p != blank and v and v.available -%}
          <div class="ucbn__item" {{ block.shopify_attributes }}>
            <span class="ucbn__thumb">
              {%- if p.featured_media -%}
                <img src="{{ p.featured_media | image_url: width: 400 }}"
                     width="200" height="200"
                     alt="{{ p.title | escape }}"
                     loading="lazy">
              {%- endif -%}
            </span>
            <span class="ucbn__name">{{ block.settings.label | default: p.title | escape }}</span>
          </div>
          {%- unless forloop.last -%}<span class="ucbn__plus" aria-hidden="true">+</span>{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
#uc-bundle-{{ section.id }}{padding:6px 16px 32px}
#uc-bundle-{{ section.id }} .ucbn__card{padding:22px 18px;border:1px solid #eedde8;border-radius:20px;background:linear-gradient(160deg,{{ section.settings.bg_from }},{{ section.settings.bg_to }})}
#uc-bundle-{{ section.id }} .ucbn__pill{display:inline-block;padding:4px 10px;border-radius:999px;background:#d81b8c;color:#fff;font-size:11px;font-weight:800;letter-spacing:.04em}
#uc-bundle-{{ section.id }} .ucbn__heading{margin:10px 0 4px;font-family:var(--heading-font-family);font-weight:600;font-size:20px;letter-spacing:-.02em;color:#1a1a1a}
#uc-bundle-{{ section.id }} .ucbn__text{margin:0 0 16px;font-size:13px;color:#6b6b6b;line-height:1.5}
#uc-bundle-{{ section.id }} .ucbn__items{display:flex;align-items:center;gap:6px}
#uc-bundle-{{ section.id }} .ucbn__item{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;min-width:0}
#uc-bundle-{{ section.id }} .ucbn__thumb{display:block;width:100%;aspect-ratio:1/1;border-radius:12px;overflow:hidden;border:1px solid rgba(216,27,140,.12);background:#fff}
#uc-bundle-{{ section.id }} .ucbn__thumb img{width:100%;height:100%;object-fit:cover;display:block}
#uc-bundle-{{ section.id }} .ucbn__name{height:26px;overflow:hidden;font-size:10.5px;line-height:1.2;text-align:center;color:#1a1a1a}
#uc-bundle-{{ section.id }} .ucbn__plus{padding-bottom:24px;font-size:20px;font-weight:300;color:#d81b8c}
#uc-bundle-{{ section.id }} .ucbn__buy{display:flex;align-items:center;justify-content:space-between;gap:12px;order:2;margin-top:16px;padding-top:16px;border-top:1px dashed rgba(216,27,140,.25)}
#uc-bundle-{{ section.id }} .ucbn__orig{display:block;font-size:12px;color:rgba(0,0,0,.4);text-decoration:line-through}
#uc-bundle-{{ section.id }} .ucbn__price{display:block;font-family:var(--heading-font-family);font-size:22px;font-weight:800;color:#d81b8c}
#uc-bundle-{{ section.id }} .ucbn__btn{padding:13px 22px;border:0;border-radius:999px;background:#d81b8c;color:#fff;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 6px 18px rgba(216,27,140,.28);transition:background-color .15s ease}
#uc-bundle-{{ section.id }} .ucbn__btn:hover{background:#9e0055}
#uc-bundle-{{ section.id }} .ucbn__btn[disabled]{opacity:.7;cursor:default}

/* Mobilde satın alma satırı ürünlerin altına düşer. */
#uc-bundle-{{ section.id }} .ucbn__card{display:flex;flex-direction:column}
#uc-bundle-{{ section.id }} .ucbn__copy{display:contents}
#uc-bundle-{{ section.id }} .ucbn__items{order:1}

@media(min-width:1024px){
#uc-bundle-{{ section.id }}{padding:0 40px 60px}
#uc-bundle-{{ section.id }} .ucbn__card{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;max-width:1280px;margin:0 auto;padding:44px;border-radius:28px}
#uc-bundle-{{ section.id }} .ucbn__copy{display:block}
#uc-bundle-{{ section.id }} .ucbn__pill{padding:6px 14px;font-size:13px}
#uc-bundle-{{ section.id }} .ucbn__heading{margin:18px 0 8px;font-size:32px}
#uc-bundle-{{ section.id }} .ucbn__text{margin:0 0 28px;max-width:38ch;font-size:16px}
#uc-bundle-{{ section.id }} .ucbn__buy{justify-content:flex-start;gap:24px;margin-top:0;padding-top:0;border-top:0}
#uc-bundle-{{ section.id }} .ucbn__orig{font-size:15px}
#uc-bundle-{{ section.id }} .ucbn__price{font-size:34px;line-height:1}
#uc-bundle-{{ section.id }} .ucbn__btn{padding:16px 30px;font-size:16px}
#uc-bundle-{{ section.id }} .ucbn__items{gap:10px}
#uc-bundle-{{ section.id }} .ucbn__thumb{border-radius:16px}
#uc-bundle-{{ section.id }} .ucbn__name{height:auto;font-size:12.5px;line-height:1.3}
#uc-bundle-{{ section.id }} .ucbn__plus{padding-bottom:28px;font-size:28px}
}
{% endstyle %}

<script>
(function(){
  var root = document.getElementById('uc-bundle-{{ section.id }}');
  if (!root || root.dataset.ucbnReady) return;
  root.dataset.ucbnReady = '1';

  root.addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('[data-ucbn-add]') : null;
    if (!btn || btn.disabled) return;

    var ids = (btn.getAttribute('data-variants') || '').split(',').filter(Boolean);
    if (!ids.length) return;
    var code = btn.getAttribute('data-code');

    btn.disabled = true;
    var label = btn.textContent;
    btn.textContent = 'Ekleniyor...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: ids.map(function(id){ return { id: Number(id), quantity: 1 }; }) })
    })
    .then(function(r){ if (!r.ok) throw 0; return r.json(); })
    .then(function(){
      if (code) {
        window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=/cart';
        return;
      }
      btn.textContent = 'Eklendi ✓';
      try { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } })); } catch (err) {}
      setTimeout(function(){ btn.textContent = label; btn.disabled = false; }, 1800);
    })
    .catch(function(){ btn.textContent = label; btn.disabled = false; });
  });
})();
</script>

{%- elsif request.design_mode -%}
  <div class="page-width" style="padding:28px;text-align:center;color:rgba(0,0,0,.45);font-size:13px;border:1px dashed rgba(197,0,106,.25);border-radius:14px;max-width:760px;margin-inline:auto;background:#fdf5f9;">
    Set kartı gizli. Görünmesi için en az bir blokta stokta olan bir ürün seçili olmalı.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Set Al Kazan",
  "tag": "section",
  "class": "cc-uc-bundle",
  "settings": [
    { "type": "text", "id": "pill_text", "label": "Rozet metni", "default": "SET AL, %[pct] KAZAN", "info": "[pct] yerine indirim yüzdesi yazılır." },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Birlikte Daha Güçlü" },
    { "type": "textarea", "id": "text", "label": "Açıklama", "default": "Bu ürünler bir arada kullanılınca etkisi katlanır. Tek tek almak yerine sette al, kazan." },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Seti Sepete Ekle" },
    { "type": "header", "content": "Fiyatlandırma" },
    { "type": "range", "id": "discount_percent", "min": 0, "max": 70, "step": 1, "unit": "%", "label": "İndirim yüzdesi", "default": 28, "info": "Yalnızca gösterilen fiyatı hesaplar. Gerçek indirim için aşağıya bir indirim kodu gir." },
    { "type": "text", "id": "discount_code", "label": "İndirim kodu (opsiyonel)", "info": "Girilirse sepete ekledikten sonra kod otomatik uygulanır." },
    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "bg_from", "label": "Zemin degrade başlangıcı", "default": "#fff0f7" },
    { "type": "color", "id": "bg_to", "label": "Zemin degrade bitişi", "default": "#fde4ef" }
  ],
  "blocks": [
    {
      "type": "bundle_product",
      "name": "Set ürünü",
      "settings": [
        { "type": "product", "id": "product", "label": "Ürün" },
        { "type": "text", "id": "label", "label": "Kısa ad", "info": "Boşsa ürün adı kullanılır." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Set Al Kazan", "blocks": [ {"type":"bundle_product"}, {"type":"bundle_product"}, {"type":"bundle_product"} ] }
  ],
  "disabled_on": { "groups": ["header","footer","aside"] }
}
{% endschema %}
